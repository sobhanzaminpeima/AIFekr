{
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next-seo-dev/types/**/*.ts",
    ".next-commerce-release/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "scripts",
    "tools",
    "analysis",
    "output",
    ".next-academy-dev",
    ".next-seo-dev",
    ".next-seo-build",
    ".next-seo-release",
    ".next-commerce-release"
  ]
}
