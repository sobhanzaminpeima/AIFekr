/// A single AI Boardroom session — department analyses + CEO synthesis.
model BoardroomSession {
  id          String   @id @default(cuid())
  userId      String
  status      String   @default("running")
  healthScore Int?
  summary     String?
  departments String?
  tasksJson   String?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// ── Voice Agent add-on (AI real-estate calling agent) ──────────────────────
/// Gated by User.voicePlan, same pattern as crmPlan. One user can run multiple
/// named agents (e.g. "Buyer Line", "Rental Line"), each backed by a Vapi
/// assistant + phone number. See src/lib/voice/workspace.ts for the gate and
/// src/lib/voice/vapiClient.ts for the Vapi API wrapper.
model VoiceAgent {
  id                String   @id @default(cuid())
  userId            String
  name              String
  /// "buy" | "sell" | "rent" | "general" — shapes the default system prompt.
  focus             String   @default("general")
  /// "real_estate" | "general" — which Vapi tool set gets registered for this
  /// agent (see buildVoiceAgentTools() in src/lib/voice/vapiClient.ts).
  /// "real_estate" keeps the existing search_properties/book_appointment
  /// tools; "general" swaps in a business-agnostic tool set so the Voice
  /// Agent add-on works for any business, not just real estate. Extensible
  /// to future verticals without a schema change (plain string, not an enum).
  vertical          String   @default("real_estate")
  /// Free-text business type/description, only used when vertical="general"
  /// (e.g. "Dental clinic", "Law firm") — interpolated into the default
  /// system prompt so the assistant knows what business it represents.
  businessType      String?
  systemPrompt      String
  /// Vapi voice id (e.g. "jennifer") — cosmetic, defaults server-side if unset.
  voiceId           String?
  /// E.164 phone number assigned to this agent once provisioned via Vapi.
  phoneNumber       String?
  vapiAssistantId   String?
  vapiPhoneNumberId String?
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  properties    Property[]
  calls         VoiceCallLog[]
  appointments  VoiceAppointment[]
  knowledgeBase VoiceKnowledgeBase[]

  @@index([userId])
}

/// A Q&A / policy / info snippet the agent can pull from mid-call when a
/// caller asks something outside the property-search/booking flow (opening
/// hours, financing terms, company policy, etc.) — a lightweight knowledge
/// base, not a vector index. `agentId` null means it applies to every one of
/// the user's agents; set means it's specific to that one agent.
model VoiceKnowledgeBase {
  id        String   @id @default(cuid())
  userId    String
  agentId   String?
  title     String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  agent VoiceAgent? @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([agentId])
}

/// A listing the agent can reference/offer during a call. Kept separate from
/// any future generic "Property" model — intentionally scoped to this add-on.
/// Industry-agnostic "extension record" attached to a CRM contact/deal —
/// currently only populated by the real-estate voice agent (hence the
/// mapped table name, kept as-is to avoid a physical rename), but the shape
/// (owner + optional CrmContact/CrmDeal links + industry-specific columns)
/// is the reusable pattern for any future industry needing structured
/// records beyond CrmContact/CrmDeal's generic customFields JSON blob
/// (e.g. a future VehicleRecord for a car dealership would follow the same
/// shape: its own table, optional FKs into CRM, zero changes to CRM core).
model Property {
  id           String   @id @default(cuid())
  userId       String
  agentId      String?
  /// Optional link to the CRM lead interested in / associated with this
  /// property (a contact may be linked to several properties they're
  /// browsing). Nullable — a property can exist with no CRM contact yet.
  crmContactId String?
  /// Optional link to the specific deal this property is being sold/rented
  /// through — set once a contact's interest turns into an active deal.
  crmDealId    String?
  /// Optional link to a CRM Project (the general post-sale/ongoing-work
  /// tracker) — set for the real-estate industry pack's "پروژه‌های ملکی"
  /// feature, so a project's transaction-type-specific fields (short-term
  /// rental booking link/nightly price, below) live on this single unified
  /// Property row rather than a separate real-estate-only table.
  crmProjectId String?
  title        String
  /// "buy" | "sell" | "rent" | "short_term_rent"
  listingType  String
  propertyType String   @default("apartment")
  /// Price in Toman. For listingType "short_term_rent" this is unused —
  /// nightlyPrice is the relevant figure instead.
  /// BigInt, not Int — Toman real-estate prices routinely exceed 2.1B (Int32 max).
  price        BigInt
  /// Per-night price in Toman — only meaningful when listingType is
  /// "short_term_rent". BigInt for the same overflow reason as price.
  nightlyPrice BigInt?
  /// Booking-platform listing URL for short-term rentals — deliberately
  /// generic ("booking platform link"), not Airbnb-specific, so Booking.com
  /// or a future in-house booking page can be added later without a schema
  /// change. Not validated as a strict URL at the DB layer — malformed
  /// values are a warning in the UI, not a save-blocking error, since an
  /// agent may want to create the project before the listing link exists.
  bookingLink  String?
  address      String
  city         String?
  bedrooms     Int?
  bathrooms    Int?
  areaSqm      Int?
  description  String?
  /// JSON array of image URLs (uploaded via the same R2 storage used by
  /// CrmDocument). Nullable — a property can exist with no photos yet.
  images       String?
  /// IRT (Toman) | IRR (Rial) | USD | GBP | EUR — price/nightlyPrice are
  /// stored in this currency's smallest common display unit (Toman/Rial
  /// for IRT/IRR, cents-free whole units for USD/GBP/EUR — this platform
  /// doesn't handle sub-unit precision anywhere else either). Defaults to
  /// IRT since every existing row was priced in Toman before this field
  /// existed.
  currency     String   @default("IRT")
  status       String   @default("available") // available | pending | sold | rented
  /// Owner-representation terms (Section 1, item 2) — deliberately kept on
  /// Property rather than on CrmContact, since a single owner contact can
  /// have different representation dates/commission per listing. "Owner"
  /// itself is not a stored role — a contact IS an owner by being linked
  /// here via crmContactId to >=1 property; see /api/crm/owners.
  representationStartDate DateTime?
  representationEndDate   DateTime?
  /// Commission percentage agreed with the owner at listing time (e.g. 2.5
  /// meaning 2.5%) — distinct from CrmDeal's eventual closing commission
  /// (item 5), which is the actual amount once a deal closes.
  agreedCommissionRate    Float?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  agent        VoiceAgent?        @relation(fields: [agentId], references: [id], onDelete: SetNull)
  crmContact   CrmContact?        @relation(fields: [crmContactId], references: [id], onDelete: SetNull)
  crmDeal      CrmDeal?           @relation(fields: [crmDealId], references: [id], onDelete: SetNull)
  crmProject   CrmProject?        @relation(fields: [crmProjectId], references: [id], onDelete: SetNull)
  appointments VoiceAppointment[]
  viewings     PropertyViewing[]
  bookings     PropertyBooking[]
  documents    CrmDocument[]

  @@index([userId])
  @@index([agentId])
  @@index([crmContactId])
  @@index([crmDealId])
  @@index([crmProjectId])
  @@map("VoiceProperty")
}

/// Section 1, item 4 — Viewing Scheduler. A real calendar slot (not a text
/// field), so double-booking can be checked server-side, distinct from
/// VoiceAppointment (which is structurally tied to a VoiceAgent's phone
/// calls and has a required agentId). assignedToId is a human CRM team
/// member's userId — nullable until someone is assigned.
model PropertyViewing {
  id           String    @id @default(cuid())
  /// Workspace owner's id (ws.workspaceUserId), same scoping convention as
  /// every other CRM model — never the raw session user id.
  userId       String
  propertyId   String
  /// The buyer/lead attending the viewing — optional so a slot can be
  /// blocked out before a specific contact is confirmed.
  contactId    String?
  /// Human team member conducting the viewing — optional until assigned;
  /// double-booking is only checked once this is set (see api/crm/viewings).
  assignedToId String?
  scheduledAt  DateTime
  durationMin  Int       @default(30)
  /// scheduled | completed | cancelled | no_show
  status       String    @default("scheduled")
  /// Post-viewing feedback captured from the buyer or the agent — required
  /// by the master spec ("post-viewing feedback capture"), free text since
  /// the shape of useful feedback varies too much for a fixed schema.
  feedback     String?
  feedbackRating Int?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  property   Property    @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  contact    CrmContact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  assignedTo User?       @relation("PropertyViewingAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([propertyId])
  @@index([contactId])
  @@index([assignedToId])
  @@index([scheduledAt])
}

/// Section 1, item 6 — Short-term rental occupancy calendar. Mandatory (not
/// optional) UI for any Property with listingType "short_term_rent", to
/// prevent double-booking the same nights. Coordinates with (does not
/// replace) Property.bookingLink: as of this research, Airbnb/Booking.com
/// only offer one-way, non-instant iCal export/import (no live two-way
/// API for unaffiliated apps), so this table is the source of truth for
/// in-app scheduling — bookingLink stays a manual reference for the agent
/// to cross-check, not an automated sync target.
model PropertyBooking {
  id         String   @id @default(cuid())
  /// Workspace owner's id, same scoping convention as every other CRM model.
  userId     String
  propertyId String
  checkIn    DateTime
  checkOut   DateTime
  guestName  String?
  /// Optional link to the CRM lead who booked, if known.
  contactId  String?
  /// manual | airbnb_ical | booking_ical — free-text today since only
  /// "manual" is actually wired up; kept open for when iCal import lands.
  source     String   @default("manual")
  /// confirmed | cancelled
  status     String   @default("confirmed")
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  property Property    @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  contact  CrmContact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([propertyId])
  @@index([contactId])
  @@index([checkIn])
  @@index([checkOut])
}

/// One row per phone call handled by a VoiceAgent, populated from Vapi's
/// end-of-call-report webhook (see src/app/api/webhooks/vapi/route.ts).
model VoiceCallLog {
  id           String    @id @default(cuid())
  userId       String
  agentId      String
  /// Best-effort match to a CRM contact by phone number (see matchCrmContactByPhone()
  /// in src/lib/voice/crmLink.ts) — null when no match was found. Never
  /// auto-creates a new CrmContact; that stays a manual/user decision.
  contactId    String?
  vapiCallId   String?   @unique
  callerPhone  String?
  direction    String    @default("inbound") // inbound | outbound
  status       String    @default("in_progress") // in_progress | completed | failed | no_answer
  /// qualified | not_interested | appointment_booked | callback_requested | unknown
  outcome      String?
  transcript   String?
  summary      String?
  durationSec  Int?
  recordingUrl String?
  /// Call cost in USD, as reported by Vapi.
  cost         Float?
  createdAt    DateTime  @default(now())
  endedAt      DateTime?

  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  agent       VoiceAgent        @relation(fields: [agentId], references: [id], onDelete: Cascade)
  contact     CrmContact?       @relation(fields: [contactId], references: [id], onDelete: SetNull)
  appointment VoiceAppointment?

  @@index([userId])
  @@index([agentId])
  @@index([contactId])
}

/// A property viewing booked by the agent during (or after) a call.
model VoiceAppointment {
  id          String   @id @default(cuid())
  userId      String
  agentId     String
  propertyId  String?
  callLogId   String?  @unique
  leadName    String?
  leadPhone   String?
  scheduledAt DateTime
  status      String   @default("pending") // pending | confirmed | completed | cancelled | no_show
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  agent    VoiceAgent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  property Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  callLog  VoiceCallLog?  @relation(fields: [callLogId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([agentId])
}
