generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                        String    @id @default(cuid())
  email                     String?   @unique
  phone                     String?   @unique
  passwordHash              String?
  name                      String?
  /// Split out from `name` so registration/admin can collect them separately.
  /// `name` stays in sync (firstName + " " + lastName) so every existing
  /// caller that reads `user.name` keeps working unchanged.
  firstName                 String?
  lastName                  String?
  /// ISO 3166-1 alpha-2 country code (e.g. "IR", "DE", "US") — collected at
  /// registration and editable from the admin panel.
  country                   String?
  /// "fa" | "en" | "de" — chosen at registration. The `lang` cookie is the
  /// live, changeable-anytime preference (LanguageSwitcher), but it's just a
  /// browser cookie: gone on a new device/browser or if cleared. This column
  /// is what login uses to re-set that cookie, so the choice actually
  /// survives across logins instead of silently reverting to the site default.
  language                  String?
  /// User's preferred display currency for fixed-amount displays (referral
  /// wallet, etc.) outside the accounting module, which already has its own
  /// per-property currency. Null means "derive from UI language" (existing
  /// behavior, unchanged for anyone who hasn't picked one explicitly).
  /// "IRT" | "USD" | "EUR".
  currency                  String?
  avatar                    String?
  role                      String    @default("USER")
  plan                      String    @default("FREE")
  credits                   Int       @default(100)
  // Phase 2 of the monetization overhaul: the single `credits` pool is being
  // split into three separately-tracked wallets, matching how the master
  // prompt's pricing model actually meters usage (AI chat tokens, media
  // generation, voice minutes are different cost shapes and need to be
  // capped/sold separately). `credits` is kept as-is during the transition
  // -- nothing stops writing to it yet, so existing code paths (plan
  // activation, credit-tier purchases) keep working unchanged until Phase 3
  // (billing/plan restructuring) moves them onto the wallets directly. A
  // one-time backfill script (scripts/split-credits-into-wallets.js) splits
  // each user's existing `credits` balance into these three proportionally
  // to their real historical usage mix from UsageLog, per the user's
  // explicit decision to migrate this way rather than an even 3-way split.
  aiCredits                 Float     @default(0)
  mediaCredits              Float     @default(0)
  voiceMinutes              Float     @default(0)
  planExpiry                DateTime?
  /// Voice Agent add-on tier, purchased and billed separately from `plan` —
  /// same pattern as crmPlan. "NONE" | "ACTIVE".
  voicePlan                 String    @default("NONE")
  voicePlanExpiry           DateTime?
  /// CRM add-on tier, purchased and billed separately from `plan` (the AI-usage
  /// tier) — buying CRM must never overwrite a user's AI plan. "NONE" | "SOLO" | "TEAM".
  crmPlan                   String    @default("NONE")
  crmPlanExpiry             DateTime?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt
  lastLoginAt               DateTime?
  isBlocked                 Boolean   @default(false)
  industryPackId            String?
  /// Google OAuth subject id — set when the user signs in with Google
  googleId                  String?   @unique
  /// How this account authenticates: "password" | "google"
  authProvider              String    @default("password")
  /// If true, the CEO orchestrator runs automatically once a day (via cron) and emails a digest — opt-in, off by default.
  ceoAutoRunEnabled         Boolean   @default(false)
  /// Language for the unattended daily CEO briefing. The cron has no request,
  /// so it cannot read the `lang` cookie the interactive route uses — without
  /// this column every scheduled briefing went out in Persian regardless of
  /// the user's language. Captured from the UI language when auto-run is
  /// switched on. Same pattern as AccountingScheduledReport.lang.
  ceoAutoRunLang            String    @default("fa")
  /// Onboarding wizard completed
  onboardingDone            Boolean   @default(false)
  /// Referral system
  referralCode              String?   @unique
  referredBy                String?
  /// True once the referral signup bonus has been granted to both this user and their referrer — prevents double-granting on plan renewals.
  referralRewarded          Boolean   @default(false)
  /// Affiliate wallet balance in Toman — earned as a configurable % commission
  /// (see SiteSetting key "referral_commission_percent", src/lib/utils/referralWallet.ts)
  /// whenever a user this account referred makes a purchase. Never moved by
  /// automated code beyond the transactions in WalletTransaction — cash
  /// payouts always go through a WalletPayoutRequest an admin resolves
  /// manually after actually sending the money outside this app.
  walletBalance             Int       @default(0)
  /// Per-user referral commission override, in percent (0-100) — takes
  /// priority over the global `referral_commission_percent` site setting.
  /// Null means "use the global default."
  commissionPercentOverride Int?

  /// Admin "Invite to AIfekr" tool (src/app/admin/invites). A trial
  /// activation ALSO sets the real plan/planExpiry fields above (those are
  /// what every plan-gated feature actually checks) — these fields are the
  /// audit trail of "this was a trial, granted by whom, for what package,"
  /// distinct from a normal paid Pro subscription.
  mustChangePassword Boolean   @default(false)
  trialPlan          String?
  trialStartsAt      DateTime?
  trialEndsAt        DateTime?
  realEstatePackage  Boolean   @default(false)
  /// The "referral trial" package: full Pro trial except Video Generator and
  /// Website Designer, which show an upgrade prompt instead of running.
  /// Independent of trialPlan/trialStartsAt/trialEndsAt (which just record
  /// the trial's dates) -- this is the one flag every gated route checks.
  trialLimited       Boolean   @default(false)
  invitedByAdminId   String?
  invitedAt          DateTime?

  conversations            Conversation[]
  projects                 Project[]
  images                   GeneratedImage[]
  videos                   GeneratedVideo[]
  musics                   GeneratedMusic[]
  payments                 Payment[]
  walletTransactions       WalletTransaction[]
  walletPayoutRequests     WalletPayoutRequest[]
  usageLogs                UsageLog[]
  otpCodes                 OtpCode[]
  crmContacts              CrmContact[]
  crmContactsAssigned      CrmContact[]          @relation("CrmContactAssignee")
  inviteCards              InviteCard[]
  crmPipelines             CrmPipeline[]
  crmDealsOwned            CrmDeal[]             @relation("CrmDealOwnerUser")
  crmDealsAssigned         CrmDeal[]             @relation("CrmDealAssignee")
  propertyViewingsAssigned PropertyViewing[]     @relation("PropertyViewingAssignee")
  crmDocuments             CrmDocument[]
  crmAutomationRules       CrmAutomationRule[]
  crmActivities            CrmActivity[]
  crmTasks                 CrmTask[]
  crmInsights              CrmInsight[]
  crmAnalysisRuns          CrmAnalysisRun[]
  leadForms                LeadForm[]
  leadSources              LeadSource[]
  socialBrandProfile       SocialBrandProfile?
  socialCompetitors        SocialCompetitor[]
  crmProducts              CrmProduct[]
  crmInvoices              CrmInvoice[]
  crmContracts             CrmContract[]
  crmContractTemplates     CrmContractTemplate[]
  crmNotes                 CrmNote[]
  crmProjects              CrmProject[]
  businessAnalyses         BusinessAnalysis[]
  socialPosts              SocialPost[]
  generatedWebsites        GeneratedWebsite[]
  industryPack             IndustryPack?         @relation(fields: [industryPackId], references: [id])
  company                  Company?
  ownedTeam                Team?                 @relation("TeamOwner")
  teamMembership           TeamMember?
  seoConnection            SeoConnection?
  gscConnection            GscConnection?
  seoSites                 SeoSite[]
  instagramConnections     InstagramConnection[]
  scheduledPosts           ScheduledPost[]
  pipelineRuns             ContentPipelineRun[]
  agentLessons             ContentAgentLesson[]
  contentPosts             ContentPost[]
  businessMemories         BusinessMemory[]
  startupProjects          StartupProject[]
  startupInquiries         StartupInquiry[]
  ceoTasks                 CeoTask[]
  boardroomSessions        BoardroomSession[]
  voiceAgents              VoiceAgent[]
  voiceProperties          Property[]
  moduleOverrides          UserModuleOverride[]
  voiceCallLogs            VoiceCallLog[]
  voiceAppointments        VoiceAppointment[]
  voiceKnowledgeBase       VoiceKnowledgeBase[]
  notifications            Notification[]
  ownedOrganizations       Organization[]        @relation("OrganizationOwner")
  organizationMemberships  OrganizationMember[]
  businessMemberships      BusinessMember[]
  businessesCreated        BusinessWorkspace[]   @relation("BusinessCreator")
  activeBusinessId         String?
  activeBusiness           BusinessWorkspace?    @relation("ActiveBusiness", fields: [activeBusinessId], references: [id])
  organizationLedgerEntries OrganizationCreditLedger[] @relation("OrganizationLedgerActor")
  organizationAuditEvents  OrganizationAuditLog[] @relation("OrganizationAuditActor")

  @@index([industryPackId])
  @@index([activeBusinessId])
}

/// Enterprise tenant. Existing personal accounts receive exactly one default
/// organization and workspace during the backwards-compatible backfill; the
/// normal product continues to behave as it did until another workspace is
/// explicitly added.
model Organization {
  id                    String   @id @default(cuid())
  name                  String
  slug                  String   @unique
  logoUrl               String?
  industry              String?
  country               String?
  timezone              String   @default("UTC")
  currency              String   @default("USD")
  language              String   @default("fa")
  brandSettings         String?
  resourceStrategy      String   @default("SHARED") // SHARED | ALLOCATED
  planType              String   @default("PERSONAL")
  status                String   @default("ACTIVE") // ACTIVE | GRACE | SUSPENDED | ARCHIVED
  subscriptionStartsAt  DateTime?
  subscriptionEndsAt    DateTime?
  renewalStatus         String?
  aiCredits             Float    @default(0)
  mediaCredits          Float    @default(0)
  voiceMinutes          Float    @default(0)
  ownerId               String
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  owner        User                     @relation("OrganizationOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members      OrganizationMember[]
  businesses   BusinessWorkspace[]
  ledger       OrganizationCreditLedger[]
  featureFlags OrganizationFeatureFlag[]
  auditLogs    OrganizationAuditLog[]

  @@index([ownerId])
  @@index([status])
}

/// A separately authorized operating workspace inside an Organization. New
/// module records will attach here; legacy records remain available through a
/// user's default workspace until their module-specific migration is applied.
model BusinessWorkspace {
  id                String   @id @default(cuid())
  organizationId    String
  name              String
  slug              String   @unique
  logoUrl           String?
  businessType      String?
  industry          String?
  description       String?
  website           String?
  email             String?
  phone             String?
  country           String?
  timezone          String   @default("UTC")
  currency          String   @default("USD")
  /// The business's own working language (fa | en | de | tr) -- distinct from a viewer's personal UI-language cookie.
  language          String   @default("fa")
  brandSettings     String?
  aiInstructions    String?
  modules           String?  // JSON configuration; module access is server-checked.
  status            String   @default("ACTIVE") // ACTIVE | ARCHIVED
  createdById       String?
  aiCreditLimit     Float?
  mediaCreditLimit  Float?
  voiceMinuteLimit  Float?
  limitMode         String   @default("NONE") // NONE | SOFT | HARD
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  organization Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User?                        @relation("BusinessCreator", fields: [createdById], references: [id], onDelete: SetNull)
  members      BusinessMember[]
  activeUsers  User[]                       @relation("ActiveBusiness")
  ledger       OrganizationCreditLedger[]
  auditLogs    OrganizationAuditLog[]

  @@index([organizationId, status])
  @@index([createdById])
}

/// Organization-level identity and role. `allBusinesses` is an explicit
/// grant; it is never inferred from a client-provided business id.
model OrganizationMember {
  id            String   @id @default(cuid())
  organizationId String
  userId        String
  role          String   @default("MEMBER") // OWNER | ADMIN | MANAGER | MEMBER | VIEWER
  allBusinesses Boolean  @default(false)
  status        String   @default("ACTIVE") // ACTIVE | INVITED | SUSPENDED
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  businesses   BusinessMember[]

  @@unique([organizationId, userId])
  @@index([userId, status])
}

/// Explicit per-business entitlement for a member who does not have
/// OrganizationMember.allBusinesses. Permissions are an extensible JSON list
/// and must be evaluated server-side through organization/context.ts.
model BusinessMember {
  id                   String   @id @default(cuid())
  businessId           String
  organizationMemberId String
  userId               String
  role                 String   @default("MEMBER")
  permissions          String?
  status               String   @default("ACTIVE")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  business           BusinessWorkspace  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  organizationMember OrganizationMember @relation(fields: [organizationMemberId], references: [id], onDelete: Cascade)
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([businessId, userId])
  @@index([organizationMemberId])
  @@index([userId, status])
}

/// Immutable organization resource ledger. Balances are fast projections;
/// this table is the audit source of truth for grants, usage, refunds and
/// manual adjustments. idempotencyKey prevents retried jobs from charging
/// twice.
model OrganizationCreditLedger {
  id             String   @id @default(cuid())
  organizationId String
  businessId     String?
  userId         String?
  resourceType   String   // AI_CREDIT | MEDIA_CREDIT | VOICE_MINUTE
  direction      String   // GRANT | USAGE | REFUND | ADJUSTMENT
  amount         Float
  feature        String?
  provider       String?
  model          String?
  providerCostUsd Float?
  metadata       String?
  idempotencyKey String?  @unique
  createdAt      DateTime @default(now())

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  business     BusinessWorkspace? @relation(fields: [businessId], references: [id], onDelete: SetNull)
  user         User?              @relation("OrganizationLedgerActor", fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([businessId, createdAt])
  @@index([userId, createdAt])
}

model OrganizationFeatureFlag {
  id             String   @id @default(cuid())
  organizationId String
  key            String
  enabled        Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, key])
}

model OrganizationAuditLog {
  id             String   @id @default(cuid())
  organizationId String
  businessId     String?
  actorId        String?
  action         String
  targetType     String?
  targetId       String?
  metadata       String?
  createdAt      DateTime @default(now())

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  business     BusinessWorkspace? @relation(fields: [businessId], references: [id], onDelete: SetNull)
  actor        User?              @relation("OrganizationAuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([businessId, createdAt])
  @@index([actorId])
}

/// In-app notification for a user — created by notify() in
/// src/lib/notifications/create.ts whenever something relevant happens even
/// while the user isn't looking (new CRM lead, voice call ended, scheduled
/// post published/failed, etc). `type` is kept an open string (not an enum)
/// so new notification kinds can be added without a migration.
model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  body      String?
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
}

/// A TEAM-plan subscription shared by up to maxSeats users. Credits are
/// pooled here instead of on each User.credits once someone joins as a
/// member — see src/lib/utils/teamCredits.ts.
model Team {
  id         String    @id @default(cuid())
  name       String
  ownerId    String    @unique
  credits    Int       @default(0)
  // Same three-wallet split as User -- see User.aiCredits's schema comment.
  aiCredits    Float     @default(0)
  mediaCredits Float     @default(0)
  voiceMinutes Float     @default(0)
  planExpiry DateTime?
  maxSeats   Int       @default(5)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  owner   User         @relation("TeamOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members TeamMember[]
  invites TeamInvite[]
}

/// One row per seat filled on a Team (including the owner, so credit
/// deduction can treat every member — owner or not — the same way).
model TeamMember {
  id       String   @id @default(cuid())
  teamId   String
  userId   String   @unique
  role     String   @default("MEMBER") // OWNER | MEMBER
  /// CRM-specific role, independent of the AI-credit `role` above — only
  /// meaningful when the team owner's crmPlan is "TEAM". Null means this
  /// member has no CRM access. "OWNER" | "MANAGER" | "AGENT".
  crmRole  String?
  joinedAt DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([teamId])
}

/// A pending seat invitation sent by email, redeemed via a one-time token.
model TeamInvite {
  id        String   @id @default(cuid())
  teamId    String
  email     String
  token     String   @unique
  status    String   @default("PENDING") // PENDING | ACCEPTED | REVOKED | EXPIRED
  invitedBy String
  createdAt DateTime @default(now())
  expiresAt DateTime

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId])
  @@index([email])
}

/// Folders for organizing conversations. Was applied directly to the
/// production DB via SSH before this model existed in git — keep this in
/// sync with prisma/migrations, don't let it drift again.
model Project {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String?
  color       String   @default("#ea580c")
  icon        String   @default("folder")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversations Conversation[]

  @@index([userId])
}

model OtpCode {
  id        String   @id @default(cuid())
  phone     String
  code      String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])

  @@index([phone])
}

model Conversation {
  id        String   @id @default(cuid())
  userId    String
  title     String?
  tool      String?
  model     String   @default("claude-haiku-4-5-20251001")
  /// Bounded JSON state the /chat orchestrator carries between turns: the
  /// last business domain discussed, plus a short LRU of entity ids it
  /// surfaced (see src/lib/orchestrator/routing.ts). Bounded on purpose so
  /// token cost stays flat as a conversation grows. Ids here are never
  /// trusted on the way back in — every tool re-validates them against the
  /// workspace before use.
  routingState String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  projectId String?
  /// Business this conversation belongs to (nullable: legacy rows, and workspaces with no provisioned business).
  businessId String?

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  project  Project?  @relation(fields: [projectId], references: [id])
  messages Message[]

  @@index([userId])
  @@index([projectId])
  @@index([businessId])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  role           String
  content        String
  tokens         Int?
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

model GeneratedImage {
  id             String   @id @default(cuid())
  userId         String
  prompt         String
  style          String   @default("realistic")
  /// "standard" for the free-form Image Generator, "character_sheet" for
  /// the Character Creation submenu — lets the character panel show only
  /// the user's own saved character sheets instead of every image they've
  /// ever generated.
  kind           String   @default("standard")
  url            String
  /// User-uploaded reference photo this image was generated from, if any (image-to-image).
  sourceImageUrl String?
  isPublic       Boolean  @default(false)
  credits        Int      @default(5)
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model GeneratedVideo {
  id             String   @id @default(cuid())
  userId         String
  prompt         String
  duration       Int      @default(5)
  url            String
  /// User-uploaded reference photo this video was generated from, if any (image-to-video).
  sourceImageUrl String?
  isPublic       Boolean  @default(false)
  credits        Int      @default(20)
  /// Set once the async provider job (Replicate/Qwen) reports a terminal
  /// failure and the credits spent up-front in generate/route.ts have been
  /// refunded, so status/route.ts's polling never double-refunds the same row.
  refunded       Boolean  @default(false)
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model GeneratedMusic {
  id        String   @id @default(cuid())
  userId    String
  prompt    String
  genre     String   @default("pop")
  duration  Int      @default(30)
  url       String
  isPublic  Boolean  @default(false)
  credits   Int      @default(10)
  /// Mirrors GeneratedVideo.refunded — set once the async Replicate job
  /// reports a terminal failure and the up-front charge has been returned,
  /// so repeated status polls can never double-refund the same row. Music
  /// had no such column, so a failed generation silently kept the credits.
  refunded  Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Payment {
  id                  String   @id @default(cuid())
  userId              String
  amount              Int
  plan                String
  status              String   @default("PENDING")
  gateway             String   @default("zarinpal")
  refId               String?
  authority           String?  @unique
  createdAt           DateTime @default(now())
  /// Toman amount of the affiliate-wallet discount already subtracted from
  /// `amount` for this checkout (0 = no wallet used). Deliberately NOT
  /// deducted from the wallet at creation time — only at payment success
  /// (see payment/verify and webhooks/nowpayments) — so an abandoned or
  /// failed checkout never loses the user real wallet money for nothing.
  walletDiscountToman Int      @default(0)
  /// Billing term purchased, in months (1 = monthly, 12 = annual). Expiry is
  /// Package.duration × this. Without it an annual checkout charged the
  /// annual price but activation only ever granted one month.
  periodMonths        Int      @default(1)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Admin-configurable one-off credit top-up tiers (buy N credits for X Toman,
/// independent of any subscription plan/duration) -- purchased through the
/// same Zarinpal flow as plans, dispatched via the "CREDITS_<tierId>" prefix
/// on Payment.plan, same pattern as the CRM and VOICE add-on prefixes.
model CreditPricingTier {
  id              String   @id @default(cuid())
  creditsAmount   Int
  priceToman      Int
  /// Display-only, computed from priceToman vs. the platform's base
  /// per-credit rate -- stored so it doesn't drift if that base rate changes
  /// after the tier was set up.
  discountPercent Int      @default(0)
  /// "best_value" | "most_discount" | null -- which highlight ribbon, if any.
  badge           String?
  sortOrder       Int      @default(0)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

/// Audit ledger for User.walletBalance — every balance change is one row
/// here, so the running balance is always reconstructable/verifiable rather
/// than trusted blindly. Amount is signed Toman (positive = credit, negative
/// = debit).
model WalletTransaction {
  id               String   @id @default(cuid())
  userId           String
  /// commission | redeem_at_checkout | payout_request | payout_rejected_refund
  type             String
  amount           Int
  /// The purchase that generated a commission entry, or that a redeem
  /// discount was applied to — null for payout entries.
  relatedPaymentId String?
  /// The referred user whose purchase generated a commission entry.
  relatedUserId    String?
  payoutRequestId  String?
  note             String?
  createdAt        DateTime @default(now())

  user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  payoutRequest WalletPayoutRequest? @relation(fields: [payoutRequestId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([payoutRequestId])
}

/// A cash-out request against User.walletBalance. Creating one immediately
/// reserves (debits) the balance so it can't be double-spent while pending —
/// see POST /api/wallet/payout-request. Actually sending the money always
/// happens outside this app (bank transfer / PayPal, done by an admin
/// manually); this row is only ever marked "paid" after that already
/// happened, never used to trigger a transfer itself.
model WalletPayoutRequest {
  id             String    @id @default(cuid())
  userId         String
  amount         Int
  /// iran_sheba | iran_card | intl_card | paypal
  method         String
  sheba          String?
  cardNumber     String?
  cardHolderName String?
  paypalEmail    String?
  /// pending | paid | rejected
  status         String    @default("pending")
  adminNote      String?
  createdAt      DateTime  @default(now())
  resolvedAt     DateTime?
  resolvedById   String?

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]

  @@index([userId])
  @@index([status])
}

/// Reference data seeded once from prisma/seed-data/countries-cities.json
/// (github.com/dr5hn/countries-states-cities-database) plus Northern
/// Cyprus, added explicitly since it's absent from that dataset (a
/// disputed territory most geo-databases omit). Generic — not tied to
/// real estate — any part of the app needing a country/city picker (the
/// Property city field today) can reuse this instead of free text.
model Country {
  id     String  @id @default(cuid())
  /// ISO 3166-1 alpha-2 where one exists; 'CY-N' for Northern Cyprus,
  /// which has no official ISO code.
  iso2   String  @unique
  name   String
  nameFa String?
  nameDe String?
  emoji  String?

  cities City[]
}

model City {
  id        String  @id @default(cuid())
  countryId String
  name      String
  /// Only populated for major/well-known cities (curated list, not all
  /// ~153k rows) — machine-translating every city name isn't reliable for
  /// obscure places. Falls back to `name` in the UI when null.
  nameFa    String?
  nameDe    String?

  country Country @relation(fields: [countryId], references: [id], onDelete: Cascade)

  @@index([countryId])
  @@index([name])
}

/// A buyer/tenant lead registered as wanting a specific property this
/// agency already has — deliberately separate from Property.crmContactId
/// (the OWNER/seller link, Section 1 item 2). One property can have many
/// interested contacts, and one contact can be interested in many
/// properties, so this is its own join row rather than a second FK on
/// either side.
model PropertyInterest {
  id         String   @id @default(cuid())
  userId     String
  /// Immutable business boundary for this CRM record. Legacy rows are backfilled
  /// to the owner's default BusinessWorkspace before business-scoped reads ship.
  businessId String?
  propertyId String
  contactId  String
  note       String?
  createdAt  DateTime @default(now())

  property Property   @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  contact  CrmContact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([propertyId, contactId])
  @@index([userId])
  @@index([businessId])
  @@index([propertyId])
  @@index([contactId])
}

/// Admin-added AI providers — lets an admin plug in a new chat model (any
/// OpenAI-compatible /chat/completions endpoint) from the UI, without a code
/// change or redeploy, so it immediately becomes selectable in the business
/// post / Instagram caption model pickers.
model CustomAiProvider {
  id        String   @id @default(cuid())
  name      String
  /// "chat" | "image" | "video" — which picker (src/app/api/ai/{chat,image,video}-providers)
  /// this entry shows up in. Defaults to "chat" for rows created before this field existed.
  type      String   @default("chat")
  baseUrl   String
  apiKey    String
  model     String
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
}

model UsageLog {
  id        String   @id @default(cuid())
  userId    String
  type      String
  model     String?
  tokens    Int?
  credits   Int      @default(1)
  metadata  String?
  createdAt DateTime @default(now())
  /// Provider id from src/lib/ai/providers.ts (e.g. "claude", "gpt5") — the
  /// PROVIDERS registry, not a separate FK table, since it's a code catalog
  /// (adding a model is a code change either way; see AiModelPricing's own
  /// comment for why pricing still gets its own admin-editable table).
  provider  String?
  /// Token/media/voice breakdown, kept separate from the single `tokens`
  /// total above (which predates this and stays for backward compat) so
  /// cost math can use the actual input/output split instead of guessing a
  /// ratio. All nullable: most rows only ever populate the ones relevant to
  /// their `type` (chat -> tokens, video/music -> mediaSeconds, voice ->
  /// voiceSeconds); an image row and a chat row are never expected to fill
  /// the same columns.
  inputTokens      Int?
  outputTokens     Int?
  cachedTokens     Int?
  mediaSeconds     Float?
  voiceSeconds     Float?
  /// Estimated cost computed at charge time from AiModelPricing, before the
  /// provider's real bill is known (which for most providers here, we never
  /// actually get — see AiModelPricing's comment). Kept distinct from
  /// actualCostUsd so a future provider that DOES report real billed cost
  /// (the way Vapi already does for voice, see VoiceCallLog.cost) can fill
  /// that column without this one silently becoming misleading.
  estimatedCostUsd Float?
  actualCostUsd    Float?
  /// Client-supplied idempotency key for routes that accept one (currently
  /// none do -- reserved for Phase 6 hardening, not enforced yet).
  requestId        String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@index([provider])
}

// Admin-editable $ pricing per provider+kind, used to compute UsageLog's
// estimatedCostUsd. Deliberately NOT a full "AiProvider"/"AiModel" pair with
// priority/fallback/enable-disable columns (the master-prompt spec's shape)
// -- this app's router already owns enable/disable (providerConfig.ts,
// SiteSetting-backed, fixed this session) and provider selection/fallback
// order (router.ts's ROUTING_TABLE, code-level). Duplicating that into a
// second DB-driven system right after fixing the first one's "config reset
// by deploy" bug would give the app two sources of truth for the same
// decision. This table's only job is the dollar figure a given
// provider+kind actually costs, which had no home anywhere before.
//
// providerId matches src/lib/ai/providers.ts's Provider.id for chat/text
// models; image/video/music routes use a stable string of their own
// (e.g. "qwen-image", "replicate-video") since those aren't in that
// registry. One row per (providerId, kind).
model AiModelPricing {
  id                     String   @id @default(cuid())
  providerId             String
  /// "chat" | "image" | "video" | "music" | "voice"
  kind                   String
  /// Chat only: USD per 1,000,000 input/output tokens.
  inputPricePerMillion   Float?
  outputPricePerMillion  Float?
  /// image: USD per generated image. video/music: USD per second.
  /// voice: USD per minute. Whichever applies to `kind`.
  pricePerUnit           Float?
  isActive               Boolean  @default(true)
  updatedAt              DateTime @updatedAt
  createdAt              DateTime @default(now())

  @@unique([providerId, kind])
}

/// Server-side error events, for /admin/logs. That page's "errors" tab used to
/// say the feature wasn't implemented, which left no way to see what was
/// actually failing in production beyond SSHing to read pm2 logs.
/// Deliberately NOT a relation to User: an error is worth keeping after the
/// account that hit it is deleted, and `userId` is often null anyway
/// (unauthenticated requests, cron jobs).
model ErrorLog {
  id        String   @id @default(cuid())
  /// "error" | "warn" -- severity, so the tab can show real failures first.
  level     String   @default("error")
  /// Where it happened, e.g. "/api/chat" or "cron:instagram-analytics".
  source    String
  message   String
  /// Truncated before storage -- see logError() in src/lib/logging/errorLog.ts.
  stack     String?
  /// Correlates a report with the user's session when one is known.
  userId    String?
  /// Correlates with the browser/network trace for a single request.
  requestId String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([level, createdAt])
}

model SiteSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

/// Daily visit count for a public, no-login page (currently just
/// /share/1980s). One row per page per calendar day, incremented on every
/// page load -- enough for "how many people opened this link" without the
/// cost/complexity of a full analytics pipeline for a single page.
model PublicPageVisit {
  id    String   @id @default(cuid())
  page  String
  date  DateTime
  count Int      @default(0)

  @@unique([page, date])
  @@index([page])
}

/// Pack-level default for one gateable module/agent (see src/lib/industry/moduleAccess.ts
/// for the full decision function — this is only the "industry pack default" layer,
/// third priority behind platform-admin bypass and a per-customer UserModuleOverride).
/// moduleKey values come from the static catalog in src/lib/industry/moduleRegistry.ts.
model IndustryModuleFlag {
  id             String   @id @default(cuid())
  industryPackId String
  moduleKey      String
  enabled        Boolean  @default(true)
  updatedAt      DateTime @updatedAt

  industryPack IndustryPack @relation(fields: [industryPackId], references: [id], onDelete: Cascade)

  @@unique([industryPackId, moduleKey])
  @@index([industryPackId])
}

/// Per-customer override of a module/agent's visibility, independent of their
/// industry pack's default — always wins over IndustryModuleFlag (but loses to
/// platform-admin bypass). E.g. a real-estate customer who doesn't want the
/// commission module shown yet, without affecting any other real-estate customer.
model UserModuleOverride {
  id        String   @id @default(cuid())
  userId    String
  moduleKey String
  enabled   Boolean
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, moduleKey])
  @@index([userId])
}

model Prompt {
  id           String   @id @default(cuid())
  title        String
  /// English title — nullable so existing Persian-only rows stay valid; UI falls back to `title` when empty.
  titleEn      String?
  content      String
  /// English prompt text — same fallback rule as titleEn.
  contentEn    String?
  /// German title/text/guide. Before these existed every consumer did
  /// `lang !== "fa" ? En : Fa`, so German users always got the English prompt
  /// and the admin editor had no way to write a German one (QA 2026-09-15,
  /// Admin/Prompts). Nullable, falling back to the English field, then Persian.
  titleDe      String?
  contentDe    String?
  guideDe      String?
  category     String   @default("general")
  /// Which tool this ready-made prompt is for: "chat" | "image" | "video"
  toolType     String   @default("chat")
  /// Reference thumbnail shown in the picker UI — image/video prompts only.
  thumbnailUrl String?
  /// Short usage tip shown in the prompt detail view (e.g. "upload a clear
  /// front-facing photo" or, for a couple prompt, "upload a photo of the
  /// two of you together") -- nullable so existing rows stay valid.
  guideFa      String?
  guideEn      String?
  isActive     Boolean  @default(true)
  sortOrder    Int      @default(0)
  usedCount    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([toolType, isActive])
}

model CrmContact {
  id            String    @id @default(cuid())
  userId        String?
  businessId    String?
  /// Team member responsible for this contact — separate from userId (the
  /// workspace owner) so a team's leads/deals can be split across members.
  assignedToId  String?
  name          String
  phone         String?
  email         String?
  whatsapp      String?
  telegram      String?
  company       String?
  status        String    @default("lead")
  source        String    @default("organic")
  /// Source-specific detail as a JSON string (e.g. the Instagram conversation
  /// link, or the referring Contact's id) — shape varies by source, so this
  /// stays a free-form JSON blob rather than a rigid column set. Set once at
  /// capture time; createdAt already serves as "first captured at" since this
  /// row is never copied/recreated when a lead becomes a customer (§2.1 model).
  sourceDetails String?
  plan          String?
  totalSpent    Int       @default(0)
  notes         String?
  tags          String?
  /// Industry-specific fields (e.g. property type, budget) as a JSON string —
  /// same pattern as Company.notes, avoids a table-per-industry design.
  customFields  String?
  lastContact   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user       User? @relation(fields: [userId], references: [id])
  assignedTo User? @relation("CrmContactAssignee", fields: [assignedToId], references: [id])

  deals             CrmDeal[]
  activities        CrmActivity[]
  tasks             CrmTask[]
  documents         CrmDocument[]
  invoices          CrmInvoice[]
  contracts         CrmContract[]
  notesList         CrmNote[]
  projects          CrmProject[]
  voiceCallLogs     VoiceCallLog[]
  /// Sale/rent-side link (Property.crmContactId) — a contact IS an owner by
  /// being linked here; see /api/crm/owners. Named explicitly because a
  /// second, separate link (below) also points Property -> CrmContact.
  properties        Property[]         @relation("PropertyCrmContact")
  viewings          PropertyViewing[]
  bookings          PropertyBooking[]
  propertyInterests PropertyInterest[]
  /// Accounting module's rental-income owner (Property.ownerContactId) —
  /// was a plain unrelated string column, which meant a contact who was
  /// ONLY ever set as a rental owner (never the sale/rent crmContactId)
  /// never appeared in /api/crm/owners at all, and never showed a name on
  /// the owner-statements page. Named separately from `properties` above
  /// since both are Property -> CrmContact links.
  ownedRentalProperties Property[]      @relation("PropertyOwnerContact")

  @@index([userId])
  @@index([businessId])
  @@index([status])
  @@index([assignedToId])
}

/// A sales process (e.g. "فروش املاک") — a user can have more than one
/// (e.g. separate pipelines for sales vs. renewals). Seeded from
/// src/lib/crm/industryTemplates.ts based on the user's IndustryPack, or
/// created manually.
model CrmPipeline {
  id           String   @id @default(cuid())
  userId       String
  businessId   String?
  name         String
  /// Only populated for pipelines seeded from a template (see
  /// industryTemplates.ts) — a custom user-typed name has no translation
  /// and stays as-is in every language. Null falls back to `name`.
  nameEn       String?
  nameDe       String?
  /// Optional link to the IndustryPack.slug this pipeline's template came from.
  industrySlug String?
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user   User       @relation(fields: [userId], references: [id])
  stages CrmStage[]
  deals  CrmDeal[]

  @@index([userId])
  @@index([businessId])
}

/// One column on a pipeline's Kanban board (e.g. "بازدید", "مذاکره").
model CrmStage {
  id         String  @id @default(cuid())
  pipelineId String
  name       String
  /// Same idea as CrmPipeline.nameEn/nameDe — only set for template-seeded
  /// stages; a custom user-typed stage name has no translation.
  nameEn     String?
  nameDe     String?
  order      Int
  color      String?
  isWon      Boolean @default(false)
  isLost     Boolean @default(false)

  pipeline CrmPipeline @relation(fields: [pipelineId], references: [id])
  deals    CrmDeal[]

  @@index([pipelineId])
}

model CrmDeal {
  id                      String    @id @default(cuid())
  /// Workspace owner (whose plan/credits this deal counts against) —
  /// distinct from ownerId, the team member actually working the deal.
  userId                  String
  businessId              String?
  ownerId                 String?
  contactId               String
  pipelineId              String
  stageId                 String
  title                   String
  value                   Float     @default(0)
  probability             Int       @default(50)
  expectedCloseDate       DateTime?
  /// Industry-specific fields (e.g. propertyType, area) as a JSON string.
  customFields            String?
  status                  String    @default("open") // open | won | lost
  wonAt                   DateTime?
  lostReason              String?
  /// Section 1, item 5 — Contract & Commission. Deliberately kept on the
  /// existing CrmDeal row (deal date = wonAt, final amount = value already
  /// above) rather than a new table — this is closing-time financial data
  /// for a deal that already exists, not a separate entity. Visibility is
  /// already restricted correctly by the existing dealAgentFilter()/
  /// resolveCrmWorkspace() row-scoping: an AGENT can only ever fetch deals
  /// they own, MANAGER/OWNER can fetch every deal in the workspace — no
  /// separate access-control code needed for "relevant agent + manager
  /// only" beyond gating the fields behind the crm.contractCommission
  /// module. Commission % and a fixed amount are both stored (not derived)
  /// since real agencies negotiate either shape per deal.
  commissionRate          Float?
  commissionAmount        Float?
  /// unpaid | partial | paid
  commissionPaymentStatus String    @default("unpaid")
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  user              User                         @relation("CrmDealOwnerUser", fields: [userId], references: [id])
  assignedTo        User?                        @relation("CrmDealAssignee", fields: [ownerId], references: [id])
  contact           CrmContact                   @relation(fields: [contactId], references: [id])
  pipeline          CrmPipeline                  @relation(fields: [pipelineId], references: [id])
  stage             CrmStage                     @relation(fields: [stageId], references: [id])
  activities        CrmActivity[]
  documents         CrmDocument[]
  invoices          CrmInvoice[]
  contracts         CrmContract[]
  dealProducts      CrmDealProduct[]
  projects          CrmProject[]
  commissionRecords AccountingCommissionRecord[]
  properties        Property[]

  @@index([userId])
  @@index([businessId])
  @@index([contactId])
  @@index([pipelineId])
  @@index([stageId])
  @@index([ownerId])
}

/// Quote/contract/invoice files attached to a contact or deal — reuses the
/// project's existing S3 upload path, no new storage infra.
model CrmDocument {
  id         String   @id @default(cuid())
  userId     String
  businessId String?
  contactId  String?
  dealId     String?
  /// Section 1, item 7 — Property document archive (title deed, power of
  /// attorney, floor plan, photos). Reuses this same table rather than a
  /// parallel one — a document can attach to a property in addition to (or
  /// instead of) a contact/deal.
  propertyId String?
  name       String
  /// quote | contract | invoice | attachment | title_deed | power_of_attorney | floor_plan | photo
  type       String
  fileUrl    String
  /// R2 object key for this file — set on every upload going forward. Lets
  /// GET routes mint a fresh short-lived signed URL per authenticated
  /// request (see getSignedDownloadUrl in src/lib/storage/r2.ts) instead of
  /// handing out the long-lived link stored in fileUrl (which, before this
  /// field existed, was either a public R2_PUBLIC_URL link or a 7-day
  /// presigned URL — usable by anyone who obtained it, no re-auth). Null
  /// for rows created before this field existed; those still fall back to
  /// the legacy fileUrl since there's no key to re-sign.
  storageKey String?
  createdAt  DateTime @default(now())

  user     User        @relation(fields: [userId], references: [id])
  contact  CrmContact? @relation(fields: [contactId], references: [id])
  deal     CrmDeal?    @relation(fields: [dealId], references: [id])
  property Property?   @relation(fields: [propertyId], references: [id])

  @@index([userId])
  @@index([businessId])
  @@index([contactId])
  @@index([dealId])
  @@index([propertyId])
}

/// No-code automation rules (e.g. "remind me if a deal has no activity for
/// 3 days") — evaluated by a periodic cron job, not implemented in Phase 1.
model CrmAutomationRule {
  id           String   @id @default(cuid())
  userId       String
  businessId   String?
  name         String
  trigger      String // stale_deal | new_lead | stage_change | no_activity_days
  condition    String? // JSON, e.g. { "days": 3 }
  action       String // create_task | send_notification | notify_crm_agent
  actionParams String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([businessId])
}

model CrmActivity {
  id        String   @id @default(cuid())
  userId    String
  businessId String?
  contactId String?
  dealId    String?
  type      String // call | email | meeting | note | whatsapp | telegram
  content   String
  createdAt DateTime @default(now())

  user    User        @relation(fields: [userId], references: [id])
  contact CrmContact? @relation(fields: [contactId], references: [id])
  deal    CrmDeal?    @relation(fields: [dealId], references: [id])

  @@index([userId])
  @@index([businessId])
  @@index([contactId])
  @@index([dealId])
}

model CrmTask {
  id            String    @id @default(cuid())
  userId        String
  businessId    String?
  contactId     String?
  title         String
  dueDate       DateTime?
  status        String    @default("pending") // pending | done | overdue
  /// True for tasks the CRM Agent generated automatically (Phase 2+), vs. user-created.
  autoGenerated Boolean   @default(false)
  /// AI-drafted outbound message text (e.g. a post-viewing follow-up) for the
  /// owner to review and send themselves -- Draft-and-Approve, never sent
  /// automatically. Null for a plain internal reminder task.
  draftMessage  String?
  /// Set when status transitions to "done", cleared if reopened -- lets the
  /// UI show exactly when a follow-up was completed, not just that it was.
  completedAt   DateTime?
  createdAt     DateTime  @default(now())

  user    User        @relation(fields: [userId], references: [id])
  contact CrmContact? @relation(fields: [contactId], references: [id])

  @@index([userId])
  @@index([businessId])
  @@index([contactId])
}

/// Notes the CRM Agent (Phase 2+) wants remembered across future runs —
/// same pattern as BusinessMemory/ContentAgentLesson.
model CrmInsight {
  id          String   @id @default(cuid())
  userId      String
  businessId  String?
  category    String // pipeline_health | risk | opportunity | forecast
  text        String
  embedding   String?
  sourceRunId String?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([businessId])
}

/// A full CRM Agent pipeline-analysis run, dated. Before this model, only the
/// short "future memory" fragments the agent extracts for itself
/// (CrmInsight) were persisted -- the actual full report a user reads was
/// shown once and discarded, with no way to look back at last week's
/// analysis or see how the read on the pipeline changed over time.
model CrmAnalysisRun {
  id        String   @id @default(cuid())
  userId    String
  businessId String?
  /// The full markdown report, memory-notes section already stripped (that
  /// section is for the next run's prompt, not a human reader).
  content   String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([businessId, createdAt])
}

/// A company's product/service catalog — attached to deals (CrmDealProduct)
/// and invoice line items (CrmInvoiceItem).
model CrmProduct {
  id          String   @id @default(cuid())
  userId      String
  businessId  String?
  name        String
  sku         String?
  description String?
  price       Float
  unit        String?
  taxRate     Float    @default(0)
  isActive    Boolean  @default(true)
  imageUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user         User             @relation(fields: [userId], references: [id])
  invoiceItems CrmInvoiceItem[]
  dealProducts CrmDealProduct[]

  @@index([userId])
  @@index([businessId])
}

/// Links a product to a deal (what's being sold), snapshotting the price at
/// the time it was added so later CrmProduct price changes don't rewrite history.
model CrmDealProduct {
  id          String @id @default(cuid())
  dealId      String
  productId   String
  quantity    Float  @default(1)
  priceAtSale Float

  deal    CrmDeal    @relation(fields: [dealId], references: [id])
  product CrmProduct @relation(fields: [productId], references: [id])

  @@index([dealId])
  @@index([productId])
}

model CrmInvoice {
  id            String    @id @default(cuid())
  userId        String
  businessId    String?
  contactId     String
  dealId        String?
  /// Per-user sequential number (e.g. INV-2026-0001), minted atomically —
  /// see mintInvoiceNumber() in src/lib/repositories/crmInvoiceRepository.ts.
  invoiceNumber String    @unique
  status        String    @default("draft") // draft | sent | paid | overdue | cancelled
  issueDate     DateTime  @default(now())
  dueDate       DateTime?
  paidAt        DateTime?
  subtotal      Float     @default(0)
  taxTotal      Float     @default(0)
  discount      Float     @default(0)
  total         Float     @default(0)
  currency      String    @default("IRT")
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user      User                 @relation(fields: [userId], references: [id])
  contact   CrmContact           @relation(fields: [contactId], references: [id])
  deal      CrmDeal?             @relation(fields: [dealId], references: [id])
  items     CrmInvoiceItem[]
  revisions CrmInvoiceRevision[]

  @@index([userId])
  @@index([businessId])
  @@index([contactId])
  @@index([dealId])
}

model CrmInvoiceItem {
  id          String  @id @default(cuid())
  invoiceId   String
  productId   String?
  description String
  quantity    Float   @default(1)
  unitPrice   Float
  taxRate     Float   @default(0)
  lineTotal   Float

  invoice CrmInvoice  @relation(fields: [invoiceId], references: [id])
  product CrmProduct? @relation(fields: [productId], references: [id])

  @@index([invoiceId])
}

model CrmContractTemplate {
  id           String   @id @default(cuid())
  userId       String
  businessId   String?
  name         String
  industrySlug String?
  /// Template text with {{contactName}}/{{dealValue}}/... placeholders,
  /// interpolated by interpolateTemplate() in src/lib/crm/contractTemplate.ts.
  content      String
  createdAt    DateTime @default(now())

  user      User          @relation(fields: [userId], references: [id])
  contracts CrmContract[]

  @@index([userId])
  @@index([businessId])
