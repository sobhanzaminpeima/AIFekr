generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                        String    @id @default(cuid())
  email                     String?   @unique
  phone                     String?   @unique
  passwordHash              String?
  name                      String?
  avatar                    String?
  role                      String    @default("USER")
  plan                      String    @default("FREE")
  credits                   Int       @default(100)
  planExpiry                DateTime?
  /// Voice Agent add-on tier, purchased and billed separately from `plan` —
  /// same pattern as crmPlan. "NONE" | "ACTIVE".
  voicePlan                 String    @default("NONE")
  voicePlanExpiry           DateTime?
  /// CRM add-on tier, purchased and billed separately from `plan` (the AI-usage
  /// tier) — buying CRM must never overwrite a user's AI plan. "NONE" | "SOLO" | "TEAM".
  crmPlan                   String    @default("NONE")
  crmPlanExpiry             DateTime?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt
  lastLoginAt               DateTime?
  isBlocked                 Boolean   @default(false)
  industryPackId            String?
  /// Google OAuth subject id — set when the user signs in with Google
  googleId                  String?   @unique
  /// How this account authenticates: "password" | "google"
  authProvider              String    @default("password")
  /// If true, the CEO orchestrator runs automatically once a day (via cron) and emails a digest — opt-in, off by default.
  ceoAutoRunEnabled         Boolean   @default(false)
  /// Language for the unattended daily CEO briefing. The cron has no request,
  /// so it cannot read the `lang` cookie the interactive route uses — without
  /// this column every scheduled briefing went out in Persian regardless of
  /// the user's language. Captured from the UI language when auto-run is
  /// switched on. Same pattern as AccountingScheduledReport.lang.
  ceoAutoRunLang            String    @default("fa")
  /// Onboarding wizard completed
  onboardingDone            Boolean   @default(false)
  /// Referral system
  referralCode              String?   @unique
  referredBy                String?
  /// True once the referral signup bonus has been granted to both this user and their referrer — prevents double-granting on plan renewals.
  referralRewarded          Boolean   @default(false)
  /// Affiliate wallet balance in Toman — earned as a configurable % commission
  /// (see SiteSetting key "referral_commission_percent", src/lib/utils/referralWallet.ts)
  /// whenever a user this account referred makes a purchase. Never moved by
  /// automated code beyond the transactions in WalletTransaction — cash
  /// payouts always go through a WalletPayoutRequest an admin resolves
  /// manually after actually sending the money outside this app.
  walletBalance             Int       @default(0)
  /// Per-user referral commission override, in percent (0-100) — takes
  /// priority over the global `referral_commission_percent` site setting.
  /// Null means "use the global default."
  commissionPercentOverride Int?

  /// Admin "Invite to AIfekr" tool (src/app/admin/invites). A trial
  /// activation ALSO sets the real plan/planExpiry fields above (those are
  /// what every plan-gated feature actually checks) — these fields are the
  /// audit trail of "this was a trial, granted by whom, for what package,"
  /// distinct from a normal paid Pro subscription.
  mustChangePassword Boolean   @default(false)
  trialPlan          String?
  trialStartsAt      DateTime?
  trialEndsAt        DateTime?
  realEstatePackage  Boolean   @default(false)
  invitedByAdminId   String?
  invitedAt          DateTime?

  conversations            Conversation[]
  projects                 Project[]
  images                   GeneratedImage[]
  videos                   GeneratedVideo[]
  musics                   GeneratedMusic[]
  payments                 Payment[]
  walletTransactions       WalletTransaction[]
  walletPayoutRequests     WalletPayoutRequest[]
  usageLogs                UsageLog[]
  otpCodes                 OtpCode[]
  crmContacts              CrmContact[]
  crmContactsAssigned      CrmContact[]          @relation("CrmContactAssignee")
  inviteCards              InviteCard[]
  crmPipelines             CrmPipeline[]
  crmDealsOwned            CrmDeal[]             @relation("CrmDealOwnerUser")
  crmDealsAssigned         CrmDeal[]             @relation("CrmDealAssignee")
  propertyViewingsAssigned PropertyViewing[]     @relation("PropertyViewingAssignee")
  crmDocuments             CrmDocument[]
  crmAutomationRules       CrmAutomationRule[]
  crmActivities            CrmActivity[]
  crmTasks                 CrmTask[]
  crmInsights              CrmInsight[]
  crmProducts              CrmProduct[]
  crmInvoices              CrmInvoice[]
  crmContracts             CrmContract[]
  crmContractTemplates     CrmContractTemplate[]
  crmNotes                 CrmNote[]
  crmProjects              CrmProject[]
  businessAnalyses         BusinessAnalysis[]
  socialPosts              SocialPost[]
  generatedWebsites        GeneratedWebsite[]
  industryPack             IndustryPack?         @relation(fields: [industryPackId], references: [id])
  company                  Company?
  ownedTeam                Team?                 @relation("TeamOwner")
  teamMembership           TeamMember?
  seoConnection            SeoConnection?
  gscConnection            GscConnection?
  instagramConn            InstagramConnection?
  scheduledPosts           ScheduledPost[]
  pipelineRuns             ContentPipelineRun[]
  agentLessons             ContentAgentLesson[]
  contentPosts             ContentPost[]
  businessMemories         BusinessMemory[]
  startupProjects          StartupProject[]
  startupInquiries         StartupInquiry[]
  ceoTasks                 CeoTask[]
  boardroomSessions        BoardroomSession[]
  voiceAgents              VoiceAgent[]
  voiceProperties          Property[]
  moduleOverrides          UserModuleOverride[]
  voiceCallLogs            VoiceCallLog[]
  voiceAppointments        VoiceAppointment[]
  voiceKnowledgeBase       VoiceKnowledgeBase[]
  notifications            Notification[]

  @@index([industryPackId])
}

/// In-app notification for a user — created by notify() in
/// src/lib/notifications/create.ts whenever something relevant happens even
/// while the user isn't looking (new CRM lead, voice call ended, scheduled
/// post published/failed, etc). `type` is kept an open string (not an enum)
/// so new notification kinds can be added without a migration.
model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  body      String?
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
}

/// A TEAM-plan subscription shared by up to maxSeats users. Credits are
/// pooled here instead of on each User.credits once someone joins as a
/// member — see src/lib/utils/teamCredits.ts.
model Team {
  id         String    @id @default(cuid())
  name       String
  ownerId    String    @unique
  credits    Int       @default(0)
  planExpiry DateTime?
  maxSeats   Int       @default(5)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  owner   User         @relation("TeamOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members TeamMember[]
  invites TeamInvite[]
}

/// One row per seat filled on a Team (including the owner, so credit
/// deduction can treat every member — owner or not — the same way).
model TeamMember {
  id       String   @id @default(cuid())
  teamId   String
  userId   String   @unique
  role     String   @default("MEMBER") // OWNER | MEMBER
  /// CRM-specific role, independent of the AI-credit `role` above — only
  /// meaningful when the team owner's crmPlan is "TEAM". Null means this
  /// member has no CRM access. "OWNER" | "MANAGER" | "AGENT".
  crmRole  String?
  joinedAt DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([teamId])
}

/// A pending seat invitation sent by email, redeemed via a one-time token.
model TeamInvite {
  id        String   @id @default(cuid())
  teamId    String
  email     String
  token     String   @unique
  status    String   @default("PENDING") // PENDING | ACCEPTED | REVOKED | EXPIRED
  invitedBy String
  createdAt DateTime @default(now())
  expiresAt DateTime

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId])
  @@index([email])
}

/// Folders for organizing conversations. Was applied directly to the
/// production DB via SSH before this model existed in git — keep this in
/// sync with prisma/migrations, don't let it drift again.
model Project {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String?
  color       String   @default("#ea580c")
  icon        String   @default("folder")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversations Conversation[]

  @@index([userId])
}

model OtpCode {
  id        String   @id @default(cuid())
  phone     String
  code      String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])

  @@index([phone])
}

model Conversation {
  id        String   @id @default(cuid())
  userId    String
  title     String?
  tool      String?
  model     String   @default("claude-haiku-4-5-20251001")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  projectId String?

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  project  Project?  @relation(fields: [projectId], references: [id])
  messages Message[]

  @@index([userId])
  @@index([projectId])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  role           String
  content        String
  tokens         Int?
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

model GeneratedImage {
  id             String   @id @default(cuid())
  userId         String
  prompt         String
  style          String   @default("realistic")
  /// "standard" for the free-form Image Generator, "character_sheet" for
  /// the Character Creation submenu — lets the character panel show only
  /// the user's own saved character sheets instead of every image they've
  /// ever generated.
  kind           String   @default("standard")
  url            String
  /// User-uploaded reference photo this image was generated from, if any (image-to-image).
  sourceImageUrl String?
  isPublic       Boolean  @default(false)
  credits        Int      @default(5)
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model GeneratedVideo {
  id             String   @id @default(cuid())
  userId         String
  prompt         String
  duration       Int      @default(5)
  url            String
  /// User-uploaded reference photo this video was generated from, if any (image-to-video).
  sourceImageUrl String?
  isPublic       Boolean  @default(false)
  credits        Int      @default(20)
  /// Set once the async provider job (Replicate/Qwen) reports a terminal
  /// failure and the credits spent up-front in generate/route.ts have been
  /// refunded, so status/route.ts's polling never double-refunds the same row.
  refunded       Boolean  @default(false)
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model GeneratedMusic {
  id        String   @id @default(cuid())
  userId    String
  prompt    String
  genre     String   @default("pop")
  duration  Int      @default(30)
  url       String
  isPublic  Boolean  @default(false)
  credits   Int      @default(10)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Payment {
  id                  String   @id @default(cuid())
  userId              String
  amount              Int
  plan                String
  status              String   @default("PENDING")
  gateway             String   @default("zarinpal")
  refId               String?
  authority           String?  @unique
  createdAt           DateTime @default(now())
  /// Toman amount of the affiliate-wallet discount already subtracted from
  /// `amount` for this checkout (0 = no wallet used). Deliberately NOT
  /// deducted from the wallet at creation time — only at payment success
  /// (see payment/verify and webhooks/nowpayments) — so an abandoned or
  /// failed checkout never loses the user real wallet money for nothing.
  walletDiscountToman Int      @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Audit ledger for User.walletBalance — every balance change is one row
/// here, so the running balance is always reconstructable/verifiable rather
/// than trusted blindly. Amount is signed Toman (positive = credit, negative
/// = debit).
model WalletTransaction {
  id               String   @id @default(cuid())
  userId           String
  /// commission | redeem_at_checkout | payout_request | payout_rejected_refund
  type             String
  amount           Int
  /// The purchase that generated a commission entry, or that a redeem
  /// discount was applied to — null for payout entries.
  relatedPaymentId String?
  /// The referred user whose purchase generated a commission entry.
  relatedUserId    String?
  payoutRequestId  String?
  note             String?
  createdAt        DateTime @default(now())

  user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  payoutRequest WalletPayoutRequest? @relation(fields: [payoutRequestId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([payoutRequestId])
}

/// A cash-out request against User.walletBalance. Creating one immediately
/// reserves (debits) the balance so it can't be double-spent while pending —
/// see POST /api/wallet/payout-request. Actually sending the money always
/// happens outside this app (bank transfer / PayPal, done by an admin
/// manually); this row is only ever marked "paid" after that already
/// happened, never used to trigger a transfer itself.
model WalletPayoutRequest {
  id             String    @id @default(cuid())
  userId         String
  amount         Int
  /// iran_sheba | iran_card | intl_card | paypal
  method         String
  sheba          String?
  cardNumber     String?
  cardHolderName String?
  paypalEmail    String?
  /// pending | paid | rejected
  status         String    @default("pending")
  adminNote      String?
  createdAt      DateTime  @default(now())
  resolvedAt     DateTime?
  resolvedById   String?

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]

  @@index([userId])
  @@index([status])
}

/// Reference data seeded once from prisma/seed-data/countries-cities.json
/// (github.com/dr5hn/countries-states-cities-database) plus Northern
/// Cyprus, added explicitly since it's absent from that dataset (a
/// disputed territory most geo-databases omit). Generic — not tied to
/// real estate — any part of the app needing a country/city picker (the
/// Property city field today) can reuse this instead of free text.
model Country {
  id     String  @id @default(cuid())
  /// ISO 3166-1 alpha-2 where one exists; 'CY-N' for Northern Cyprus,
  /// which has no official ISO code.
  iso2   String  @unique
  name   String
  nameFa String?
  nameDe String?
  emoji  String?

  cities City[]
}

model City {
  id        String  @id @default(cuid())
  countryId String
  name      String
  /// Only populated for major/well-known cities (curated list, not all
  /// ~153k rows) — machine-translating every city name isn't reliable for
  /// obscure places. Falls back to `name` in the UI when null.
  nameFa    String?
  nameDe    String?

  country Country @relation(fields: [countryId], references: [id], onDelete: Cascade)

  @@index([countryId])
  @@index([name])
}

/// A buyer/tenant lead registered as wanting a specific property this
/// agency already has — deliberately separate from Property.crmContactId
/// (the OWNER/seller link, Section 1 item 2). One property can have many
/// interested contacts, and one contact can be interested in many
/// properties, so this is its own join row rather than a second FK on
/// either side.
model PropertyInterest {
  id         String   @id @default(cuid())
  userId     String
  propertyId String
  contactId  String
  note       String?
  createdAt  DateTime @default(now())

  property Property   @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  contact  CrmContact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([propertyId, contactId])
  @@index([userId])
  @@index([propertyId])
  @@index([contactId])
}

/// Admin-added AI providers — lets an admin plug in a new chat model (any
/// OpenAI-compatible /chat/completions endpoint) from the UI, without a code
/// change or redeploy, so it immediately becomes selectable in the business
/// post / Instagram caption model pickers.
model CustomAiProvider {
  id        String   @id @default(cuid())
  name      String
  /// "chat" | "image" | "video" — which picker (src/app/api/ai/{chat,image,video}-providers)
  /// this entry shows up in. Defaults to "chat" for rows created before this field existed.
  type      String   @default("chat")
  baseUrl   String
  apiKey    String
  model     String
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
}

model UsageLog {
  id        String   @id @default(cuid())
  userId    String
  type      String
  model     String?
  tokens    Int?
  credits   Int      @default(1)
  metadata  String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

model SiteSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

/// Pack-level default for one gateable module/agent (see src/lib/industry/moduleAccess.ts
/// for the full decision function — this is only the "industry pack default" layer,
/// third priority behind platform-admin bypass and a per-customer UserModuleOverride).
/// moduleKey values come from the static catalog in src/lib/industry/moduleRegistry.ts.
model IndustryModuleFlag {
  id             String   @id @default(cuid())
  industryPackId String
  moduleKey      String
  enabled        Boolean  @default(true)
  updatedAt      DateTime @updatedAt

  industryPack IndustryPack @relation(fields: [industryPackId], references: [id], onDelete: Cascade)

  @@unique([industryPackId, moduleKey])
  @@index([industryPackId])
}

/// Per-customer override of a module/agent's visibility, independent of their
/// industry pack's default — always wins over IndustryModuleFlag (but loses to
/// platform-admin bypass). E.g. a real-estate customer who doesn't want the
/// commission module shown yet, without affecting any other real-estate customer.
model UserModuleOverride {
  id        String   @id @default(cuid())
  userId    String
  moduleKey String
  enabled   Boolean
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, moduleKey])
  @@index([userId])
}

model Prompt {
  id           String   @id @default(cuid())
  title        String
  /// English title — nullable so existing Persian-only rows stay valid; UI falls back to `title` when empty.
  titleEn      String?
  content      String
  /// English prompt text — same fallback rule as titleEn.
  contentEn    String?
  category     String   @default("general")
  /// Which tool this ready-made prompt is for: "chat" | "image" | "video"
  toolType     String   @default("chat")
  /// Reference thumbnail shown in the picker UI — image/video prompts only.
  thumbnailUrl String?
  isActive     Boolean  @default(true)
  sortOrder    Int      @default(0)
  usedCount    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([toolType, isActive])
}

model CrmContact {
  id            String    @id @default(cuid())
  userId        String?
  /// Team member responsible for this contact — separate from userId (the
  /// workspace owner) so a team's leads/deals can be split across members.
  assignedToId  String?
  name          String
  phone         String?
  email         String?
  whatsapp      String?
  telegram      String?
  company       String?
  status        String    @default("lead")
  source        String    @default("organic")
  /// Source-specific detail as a JSON string (e.g. the Instagram conversation
  /// link, or the referring Contact's id) — shape varies by source, so this
  /// stays a free-form JSON blob rather than a rigid column set. Set once at
  /// capture time; createdAt already serves as "first captured at" since this
  /// row is never copied/recreated when a lead becomes a customer (§2.1 model).
  sourceDetails String?
  plan          String?
  totalSpent    Int       @default(0)
  notes         String?
  tags          String?
  /// Industry-specific fields (e.g. property type, budget) as a JSON string —
  /// same pattern as Company.notes, avoids a table-per-industry design.
  customFields  String?
  lastContact   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user       User? @relation(fields: [userId], references: [id])
  assignedTo User? @relation("CrmContactAssignee", fields: [assignedToId], references: [id])

  deals             CrmDeal[]
  activities        CrmActivity[]
  tasks             CrmTask[]
  documents         CrmDocument[]
  invoices          CrmInvoice[]
  contracts         CrmContract[]
  notesList         CrmNote[]
  projects          CrmProject[]
  voiceCallLogs     VoiceCallLog[]
  properties        Property[]
  viewings          PropertyViewing[]
  bookings          PropertyBooking[]
  propertyInterests PropertyInterest[]

  @@index([userId])
  @@index([status])
  @@index([assignedToId])
}

/// A sales process (e.g. "فروش املاک") — a user can have more than one
/// (e.g. separate pipelines for sales vs. renewals). Seeded from
/// src/lib/crm/industryTemplates.ts based on the user's IndustryPack, or
/// created manually.
model CrmPipeline {
  id           String   @id @default(cuid())
  userId       String
  name         String
  /// Only populated for pipelines seeded from a template (see
  /// industryTemplates.ts) — a custom user-typed name has no translation
  /// and stays as-is in every language. Null falls back to `name`.
  nameEn       String?
  nameDe       String?
  /// Optional link to the IndustryPack.slug this pipeline's template came from.
  industrySlug String?
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user   User       @relation(fields: [userId], references: [id])
  stages CrmStage[]
  deals  CrmDeal[]

  @@index([userId])
}

/// One column on a pipeline's Kanban board (e.g. "بازدید", "مذاکره").
model CrmStage {
  id         String  @id @default(cuid())
  pipelineId String
  name       String
  /// Same idea as CrmPipeline.nameEn/nameDe — only set for template-seeded
  /// stages; a custom user-typed stage name has no translation.
  nameEn     String?
  nameDe     String?
  order      Int
  color      String?
  isWon      Boolean @default(false)
  isLost     Boolean @default(false)

  pipeline CrmPipeline @relation(fields: [pipelineId], references: [id])
  deals    CrmDeal[]

  @@index([pipelineId])
}

model CrmDeal {
  id                      String    @id @default(cuid())
  /// Workspace owner (whose plan/credits this deal counts against) —
  /// distinct from ownerId, the team member actually working the deal.
  userId                  String
  ownerId                 String?
  contactId               String
  pipelineId              String
  stageId                 String
  title                   String
  value                   Float     @default(0)
  probability             Int       @default(50)
  expectedCloseDate       DateTime?
  /// Industry-specific fields (e.g. propertyType, area) as a JSON string.
  customFields            String?
  status                  String    @default("open") // open | won | lost
  wonAt                   DateTime?
  lostReason              String?
  /// Section 1, item 5 — Contract & Commission. Deliberately kept on the
  /// existing CrmDeal row (deal date = wonAt, final amount = value already
  /// above) rather than a new table — this is closing-time financial data
  /// for a deal that already exists, not a separate entity. Visibility is
  /// already restricted correctly by the existing dealAgentFilter()/
  /// resolveCrmWorkspace() row-scoping: an AGENT can only ever fetch deals
  /// they own, MANAGER/OWNER can fetch every deal in the workspace — no
  /// separate access-control code needed for "relevant agent + manager
  /// only" beyond gating the fields behind the crm.contractCommission
  /// module. Commission % and a fixed amount are both stored (not derived)
  /// since real agencies negotiate either shape per deal.
  commissionRate          Float?
  commissionAmount        Float?
  /// unpaid | partial | paid
  commissionPaymentStatus String    @default("unpaid")
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  user              User                         @relation("CrmDealOwnerUser", fields: [userId], references: [id])
  assignedTo        User?                        @relation("CrmDealAssignee", fields: [ownerId], references: [id])
  contact           CrmContact                   @relation(fields: [contactId], references: [id])
  pipeline          CrmPipeline                  @relation(fields: [pipelineId], references: [id])
  stage             CrmStage                     @relation(fields: [stageId], references: [id])
  activities        CrmActivity[]
  documents         CrmDocument[]
  invoices          CrmInvoice[]
  contracts         CrmContract[]
  dealProducts      CrmDealProduct[]
  projects          CrmProject[]
  commissionRecords AccountingCommissionRecord[]
  properties        Property[]

  @@index([userId])
  @@index([contactId])
  @@index([pipelineId])
  @@index([stageId])
  @@index([ownerId])
}

/// Quote/contract/invoice files attached to a contact or deal — reuses the
/// project's existing S3 upload path, no new storage infra.
model CrmDocument {
  id         String   @id @default(cuid())
  userId     String
  contactId  String?
  dealId     String?
  /// Section 1, item 7 — Property document archive (title deed, power of
  /// attorney, floor plan, photos). Reuses this same table rather than a
  /// parallel one — a document can attach to a property in addition to (or
  /// instead of) a contact/deal.
  propertyId String?
  name       String
  /// quote | contract | invoice | attachment | title_deed | power_of_attorney | floor_plan | photo
  type       String
  fileUrl    String
  /// R2 object key for this file — set on every upload going forward. Lets
  /// GET routes mint a fresh short-lived signed URL per authenticated
  /// request (see getSignedDownloadUrl in src/lib/storage/r2.ts) instead of
  /// handing out the long-lived link stored in fileUrl (which, before this
  /// field existed, was either a public R2_PUBLIC_URL link or a 7-day
  /// presigned URL — usable by anyone who obtained it, no re-auth). Null
  /// for rows created before this field existed; those still fall back to
  /// the legacy fileUrl since there's no key to re-sign.
  storageKey String?
  createdAt  DateTime @default(now())

  user     User        @relation(fields: [userId], references: [id])
  contact  CrmContact? @relation(fields: [contactId], references: [id])
  deal     CrmDeal?    @relation(fields: [dealId], references: [id])
  property Property?   @relation(fields: [propertyId], references: [id])

  @@index([userId])
  @@index([contactId])
  @@index([dealId])
  @@index([propertyId])
}

/// No-code automation rules (e.g. "remind me if a deal has no activity for
/// 3 days") — evaluated by a periodic cron job, not implemented in Phase 1.
model CrmAutomationRule {
  id           String   @id @default(cuid())
  userId       String
  name         String
  trigger      String // stale_deal | new_lead | stage_change | no_activity_days
  condition    String? // JSON, e.g. { "days": 3 }
  action       String // create_task | send_notification | notify_crm_agent
  actionParams String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

model CrmActivity {
  id        String   @id @default(cuid())
  userId    String
  contactId String?
  dealId    String?
  type      String // call | email | meeting | note | whatsapp | telegram
  content   String
  createdAt DateTime @default(now())

  user    User        @relation(fields: [userId], references: [id])
  contact CrmContact? @relation(fields: [contactId], references: [id])
  deal    CrmDeal?    @relation(fields: [dealId], references: [id])

  @@index([userId])
  @@index([contactId])
  @@index([dealId])
}

model CrmTask {
  id            String    @id @default(cuid())
  userId        String
  contactId     String?
  title         String
  dueDate       DateTime?
  status        String    @default("pending") // pending | done | overdue
  /// True for tasks the CRM Agent generated automatically (Phase 2+), vs. user-created.
  autoGenerated Boolean   @default(false)
  createdAt     DateTime  @default(now())

  user    User        @relation(fields: [userId], references: [id])
  contact CrmContact? @relation(fields: [contactId], references: [id])

  @@index([userId])
  @@index([contactId])
}

/// Notes the CRM Agent (Phase 2+) wants remembered across future runs —
/// same pattern as BusinessMemory/ContentAgentLesson.
model CrmInsight {
  id          String   @id @default(cuid())
  userId      String
  category    String // pipeline_health | risk | opportunity | forecast
  text        String
  embedding   String?
  sourceRunId String?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

/// A company's product/service catalog — attached to deals (CrmDealProduct)
/// and invoice line items (CrmInvoiceItem).
model CrmProduct {
  id          String   @id @default(cuid())
  userId      String
  name        String
  sku         String?
  description String?
  price       Float
  unit        String?
  taxRate     Float    @default(0)
  isActive    Boolean  @default(true)
  imageUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user         User             @relation(fields: [userId], references: [id])
  invoiceItems CrmInvoiceItem[]
  dealProducts CrmDealProduct[]

  @@index([userId])
}

/// Links a product to a deal (what's being sold), snapshotting the price at
/// the time it was added so later CrmProduct price changes don't rewrite history.
model CrmDealProduct {
  id          String @id @default(cuid())
  dealId      String
  productId   String
  quantity    Float  @default(1)
  priceAtSale Float

  deal    CrmDeal    @relation(fields: [dealId], references: [id])
  product CrmProduct @relation(fields: [productId], references: [id])

  @@index([dealId])
  @@index([productId])
}

model CrmInvoice {
  id            String    @id @default(cuid())
  userId        String
  contactId     String
  dealId        String?
  /// Per-user sequential number (e.g. INV-2026-0001), minted atomically —
  /// see mintInvoiceNumber() in src/lib/repositories/crmInvoiceRepository.ts.
  invoiceNumber String    @unique
  status        String    @default("draft") // draft | sent | paid | overdue | cancelled
  issueDate     DateTime  @default(now())
  dueDate       DateTime?
  paidAt        DateTime?
  subtotal      Float     @default(0)
  taxTotal      Float     @default(0)
  discount      Float     @default(0)
  total         Float     @default(0)
  currency      String    @default("IRT")
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user      User                 @relation(fields: [userId], references: [id])
  contact   CrmContact           @relation(fields: [contactId], references: [id])
  deal      CrmDeal?             @relation(fields: [dealId], references: [id])
  items     CrmInvoiceItem[]
  revisions CrmInvoiceRevision[]

  @@index([userId])
  @@index([contactId])
  @@index([dealId])
}

model CrmInvoiceItem {
  id          String  @id @default(cuid())
  invoiceId   String
  productId   String?
  description String
  quantity    Float   @default(1)
  unitPrice   Float
  taxRate     Float   @default(0)
  lineTotal   Float

  invoice CrmInvoice  @relation(fields: [invoiceId], references: [id])
  product CrmProduct? @relation(fields: [productId], references: [id])

  @@index([invoiceId])
}

model CrmContractTemplate {
  id           String   @id @default(cuid())
  userId       String
  name         String
  industrySlug String?
  /// Template text with {{contactName}}/{{dealValue}}/... placeholders,
  /// interpolated by interpolateTemplate() in src/lib/crm/contractTemplate.ts.
  content      String
  createdAt    DateTime @default(now())

  user      User          @relation(fields: [userId], references: [id])
  contracts CrmContract[]

  @@index([userId])
}

model CrmContract {
  id         String    @id @default(cuid())
  userId     String
  contactId  String
  dealId     String?
  templateId String?
  title      String
  /// Final text after variable interpolation — editable afterward.
  content    String
  status     String    @default("draft") // draft | sent | signed | cancelled
  signedAt   DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user      User                  @relation(fields: [userId], references: [id])
  contact   CrmContact            @relation(fields: [contactId], references: [id])
  deal      CrmDeal?              @relation(fields: [dealId], references: [id])
  template  CrmContractTemplate?  @relation(fields: [templateId], references: [id])
  revisions CrmContractRevision[]

  @@index([userId])
  @@index([contactId])
  @@index([dealId])
}

model CrmNote {
  id        String   @id @default(cuid())
  userId    String
  contactId String
  content   String
  isPinned  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User       @relation(fields: [userId], references: [id])
  contact CrmContact @relation(fields: [contactId], references: [id])

  @@index([userId])
  @@index([contactId])
}

/// Snapshot of a CrmInvoice+items taken right before an edit to an already
/// finalized (sent/paid) invoice — so a customer who already received a copy
/// can't have it silently rewritten with no trace.
model CrmInvoiceRevision {
  id           String   @id @default(cuid())
  invoiceId    String
  snapshotJson String
  createdAt    DateTime @default(now())

  invoice CrmInvoice @relation(fields: [invoiceId], references: [id])

  @@index([invoiceId])
}

/// Same versioning guarantee as CrmInvoiceRevision, for contracts.
model CrmContractRevision {
  id         String   @id @default(cuid())
  contractId String
  content    String
  createdAt  DateTime @default(now())

  contract CrmContract @relation(fields: [contractId], references: [id])

  @@index([contractId])
}

/// Post-sale or ongoing work tracking, generic across verticals (a
/// construction job, a real-estate closing's paperwork, a service
/// engagement) — optionally linked to the Contact/Deal it came from.
model CrmProject {
  id          String    @id @default(cuid())
  userId      String
  contactId   String?
  dealId      String?
  name        String
  status      String    @default("active") // active | on_hold | completed | cancelled
  startDate   DateTime?
  endDate     DateTime?
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user     User        @relation(fields: [userId], references: [id])
  contact  CrmContact? @relation(fields: [contactId], references: [id])
  deal     CrmDeal?    @relation(fields: [dealId], references: [id])
  property Property[]

  @@index([userId])
  @@index([contactId])
  @@index([dealId])
}

/// This is the single source of truth for general-plan pricing — the
/// /plans page and /api/payment/create both read from here (matched via
/// planCode) instead of a hardcoded array, so an admin edit here actually
/// changes what users see and pay. planCode must match one of the values
/// stored on User.plan (currently BASIC | PRO | TEAM — FREE has no row
/// here since it isn't purchasable).
model Package {
  id           String   @id @default(cuid())
  planCode     String   @unique
  name         String
  nameEn       String
  /// Price in Rial (IRR). toman = price/10. Used for ZarinPal (Iran).
  price        Int
  /// Price in USD cents (e.g. 1900 = $19.00). Null means Iran-only plan.
  priceUsd     Int?
  /// Market segment: "IR" (Iran only) | "INTL" (international only) | "BOTH"
  market       String   @default("IR")
  duration     Int      @default(30)
  credits      Int
  features     String
  featuresEn   String?
  isActive     Boolean  @default(true)
  isFeatured   Boolean  @default(false)
  color        String   @default("#ea580c")
  sortOrder    Int      @default(0)
  /// Seat count included for CRM_TEAM-type packages (null for non-CRM or
  /// solo packages). Enforced against Team.maxSeats when this package is purchased.
  crmSeatLimit Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model LlmModel {
  id          String   @id @default(cuid())
  name        String
  provider    String   @default("anthropic")
  modelId     String   @unique
  description String?
  maxTokens   Int      @default(4096)
  creditCost  Int      @default(1)
  isActive    Boolean  @default(true)
  isPrimary   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model BusinessAnalysis {
  id           String   @id @default(cuid())
  userId       String
  businessName String
  industry     String
  result       String
  shareToken   String?  @unique
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model SocialPost {
  id        String   @id @default(cuid())
  userId    String
  platform  String
  topic     String
  content   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model GeneratedWebsite {
  id           String   @id @default(cuid())
  userId       String
  businessName String
  htmlCode     String
  brief        String
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Lets the SEO agent actually apply changes instead of only suggesting
/// them. "aifekr" needs no credentials (writes GeneratedWebsite.htmlCode
/// directly); "wordpress" needs a site URL + an Application Password the
/// user generates in wp-admin (never their real account password);
/// "other" has no auto-apply path — the agent only outputs recommendations.
/// One Instagram Business account per user, linked via Facebook OAuth
/// (Instagram Graph API requires a Business/Creator account connected to a
/// Facebook Page — there's no way around that, it's a Meta platform rule).
model InstagramConnection {
  id          String    @id @default(cuid())
  userId      String    @unique
  igUserId    String
  igUsername  String?
  pageId      String
  accessToken String
  tokenExpiry DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// One row per connected account per day — built by a daily cron since
/// Instagram's API only exposes the CURRENT follower/media count, not
/// history. Accumulating these snapshots is what makes a growth trend chart
/// possible at all.
model InstagramFollowerSnapshot {
  id             String   @id @default(cuid())
  userId         String
  date           DateTime // truncated to the day this snapshot was taken
  followersCount Int
  mediaCount     Int
  createdAt      DateTime @default(now())

  @@unique([userId, date])
  @@index([userId])
}

/// A keyword→DM auto-reply rule. When someone comments `keyword` on `postId`
/// (or any post, if null), the webhook handler sends them a private reply
/// with `dmMessage` via the Instagram Send API — the "comment to DM" growth
/// tactic (ManyChat-style), built natively instead of standing up the
/// separate OpenReply-fa app (own Postgres/Redis) since OAuth + tokens for
/// this account are already handled by InstagramConnection above.
model InstagramCommentCampaign {
  id                 String   @id @default(cuid())
  userId             String
  /// Comma/Persian-comma separated — any one matching the comment text triggers the campaign.
  keyword            String
  postId             String?
  /// Supports the {username} token, replaced with the commenter's handle at send time.
  dmMessage          String
  publicReplyMessage String?
  /// JSON array of up to 2 {id,label,url,clicks} — sent as tracked short links appended to dmMessage.
  links              String?
  /// When on, the real dmMessage is withheld behind a "did you follow?" button
  /// in the DM — Meta gives no API to check an arbitrary commenter's follow
  /// status, so this is a self-reported confirm via a postback button instead.
  followGateEnabled  Boolean  @default(false)
  followGatePrompt   String?
  isActive           Boolean  @default(true)
  triggerCount       Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([userId])
}

/// One row per comment the webhook actually processed — the unique
/// `commentId` is what makes handling idempotent against Meta's webhook
/// retries (a comment can only ever trigger one DM, no matter how many
/// times the same event is redelivered).
model InstagramCommentReplyLog {
  id                String   @id @default(cuid())
  campaignId        String
  /// Denormalized from the campaign's owner — lets the per-hour rate-limit
  /// count be a single indexed query instead of a join through the campaign.
  userId            String?
  commentId         String   @unique
  commenterId       String
  commenterUsername String?
  /// "sent" | "skipped" | "failed" | "awaiting_follow" (follow-gated campaign, waiting on the postback button click)
  status            String
  error             String?
  createdAt         DateTime @default(now())

  @@index([campaignId])
  @@index([userId, createdAt])
}

/// A generated Instagram post queued to go out. mode="auto" actually calls
/// the Instagram Graph API at scheduledFor (gated to PRO/TEAM plans —
/// see src/lib/utils/planGates.ts); mode="manual" just sits here so the
/// user can copy the caption/hashtags and post it themselves.
model ScheduledPost {
  id           String   @id @default(cuid())
  userId       String
  caption      String
  hashtags     String
  imageUrl     String?
  /// Reel video — mutually exclusive with imageUrl in practice (the wizard only lets the user pick one), but not DB-enforced since either alone is valid.
  videoUrl     String?
  scheduledFor DateTime
  mode         String // "auto" | "manual"
  status       String   @default("PENDING") // PENDING | PUBLISHED | FAILED
  igMediaId    String?
  errorMessage String?
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status, scheduledFor])
}

model SeoConnection {
  id            String   @id @default(cuid())
  userId        String   @unique
  platform      String // "wordpress" | "aifekr" | "other"
  siteUrl       String?
  wpUsername    String?
  wpAppPassword String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model GscConnection {
  id           String   @id @default(cuid())
  userId       String   @unique
  refreshToken String
  siteUrl      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model IndustryPack {
  id                 String               @id @default(cuid())
  slug               String               @unique
  name               String
  nameEn             String?
  emoji              String
  tagline            String
  taglineEn          String?
  valueProposition   String
  valuePropositionEn String?
  targetCustomers    String
  targetCustomersEn  String?
  painPoints         String
  painPointsEn       String?
  agents             String
  agentsEn           String?
  outcomes           String
  outcomesEn         String?
  kpis               String
  kpisEn             String?
  tier               String               @default("professional")
  price              Int                  @default(299)
  color              String
  gradientFrom       String
  gradientTo         String
  isActive           Boolean              @default(true)
  sortOrder          Int                  @default(0)
  users              User[]
  companies          Company[]
  moduleFlags        IndustryModuleFlag[]
}

model BusinessCategory {
  id        String    @id @default(cuid())
  name      String
  nameEn    String
  icon      String    @default("🏢")
  color     String    @default("#ea580c")
  isActive  Boolean   @default(true)
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())
  companies Company[]
}

model Company {
  id             String   @id @default(cuid())
  userId         String   @unique
  name           String
  industry       String
  website        String?
  phone          String?
  email          String?
  address        String?
  size           String?
  revenue        String?
  industryPackId String?
  categoryId     String?
  isActive       Boolean  @default(true)
  notes          String?
  /// Company logo, uploaded once in Business Doctor and reused on every
  /// invoice/contract (CRM) and payslip/owner-statement (accounting) print
  /// output, so a business never has to re-upload its branding per document.
  logoUrl        String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  industryPack IndustryPack?     @relation(fields: [industryPackId], references: [id])
  category     BusinessCategory? @relation(fields: [categoryId], references: [id])

  @@index([industryPackId])
  @@index([categoryId])
}

/// Logged every time the AI router falls back to a different provider.
/// Used by the admin panel to surface reliability issues.
model ProviderFallbackLog {
  id           String   @id @default(cuid())
  /// Provider that failed (e.g. "claude", "openai")
  fromProvider String
  /// Provider that took over; null if all failed
  toProvider   String?
  /// Error or timeout message (truncated to 500 chars)
  reason       String
  /// Detected prompt category (code, math, general, …)
  category     String   @default("general")
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([fromProvider])
}

/// One end-to-end run of the 8-agent content pipeline (ideaFinder → strategist →
/// researcher → writer → editor → seo → publisher → critic) for a single topic.
model ContentPipelineRun {
  id         String   @id @default(cuid())
  userId     String
  topic      String
  brandVoice String?
  /// "running" | "done" | "failed"
  status     String   @default("running")
  shareToken String?  @unique
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user  User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  steps ContentPipelineStep[]
  post  ContentPost?

  @@index([userId])
}

/// Output of a single agent within one pipeline run. A writer/editor
/// back-and-forth produces multiple rows with the same agentKey and
/// increasing `attempt`.
model ContentPipelineStep {
  id        String   @id @default(cuid())
  runId     String
  /// "ideaFinder" | "strategist" | "researcher" | "writer" | "editor" | "seo" | "publisher" | "critic"
  agentKey  String
  attempt   Int      @default(1)
  /// "running" | "done" | "failed"
  status    String   @default("running")
  input     String
  output    String?
  /// Editor's 0-100 quality score, only set for agentKey="editor"
  score     Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  run ContentPipelineRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
}

/// Persistent, accumulating feedback for one agent role — written by the
/// critic agent after a run, or manually by a user. Injected into that
/// agent's system prompt on every future run so the pipeline improves
/// over time.
model ContentAgentLesson {
  id        String   @id @default(cuid())
  userId    String
  agentKey  String
  text      String
  /// "critic" | "user"
  source    String   @default("critic")
  /// JSON-stringified embedding vector for semantic retrieval (RAG) — null
  /// if embedding generation failed or hasn't run yet; retrieval falls back
  /// to recency ordering for rows without one.
  embedding String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, agentKey])
}

/// Shared, cross-tool knowledge base for the CEO orchestrator — written by
/// the CEO agent after each analysis, or manually by the user. This is what
/// lets "the system remember" across CEO runs instead of starting from zero
/// each time, same pattern as ContentAgentLesson but business-wide rather
/// than scoped to one agent role.
model BusinessMemory {
  id        String   @id @default(cuid())
  userId    String
  /// "sales" | "content" | "seo" | "social" | "general"
  category  String   @default("general")
  text      String
  /// "ceo" | "user"
  source    String   @default("ceo")
  /// JSON-stringified embedding vector for semantic retrieval (RAG) — null
  /// if embedding generation failed or hasn't run yet; retrieval falls back
  /// to recency ordering for rows without one.
  embedding String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, category])
}

/// A published blog post produced by the pipeline.
model ContentPost {
  id              String   @id @default(cuid())
  userId          String
  runId           String   @unique
  title           String
  content         String
  metaTitle       String
  metaDescription String
  slug            String
  keywords        String
  heroImageUrl    String?
  publishedAt     DateTime @default(now())
  /// "not_published" | "published" | "failed" — result of publishing to the user's connected WordPress site
  externalStatus  String   @default("not_published")
  externalUrl     String?
  externalError   String?

  user User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  run  ContentPipelineRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model StartupProject {
