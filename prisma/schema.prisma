  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model SocialPost {
  id        String   @id @default(cuid())
  userId    String
  platform  String
  topic     String
  content   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model GeneratedWebsite {
  id           String   @id @default(cuid())
  userId       String
  businessName String
  htmlCode     String
  brief        String
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Lets the SEO agent actually apply changes instead of only suggesting
/// them. "aifekr" needs no credentials (writes GeneratedWebsite.htmlCode
/// directly); "wordpress" needs a site URL + an Application Password the
/// user generates in wp-admin (never their real account password);
/// "other" has no auto-apply path — the agent only outputs recommendations.
/// One Instagram Business account per user, linked via Facebook OAuth
/// (Instagram Graph API requires a Business/Creator account connected to a
/// Facebook Page — there's no way around that, it's a Meta platform rule).
model InstagramConnection {
  id          String    @id @default(cuid())
  userId      String
  /// Business this Instagram account belongs to (nullable: legacy rows, and workspaces with no provisioned business).
  businessId  String?
  igUserId    String
  igUsername  String?
  pageId      String
  accessToken String
  tokenExpiry DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, businessId])
  @@index([businessId])
}

/// One row per connected account per day — built by a daily cron since
/// Instagram's API only exposes the CURRENT follower/media count, not
/// history. Accumulating these snapshots is what makes a growth trend chart
/// possible at all.
model InstagramFollowerSnapshot {
  id             String   @id @default(cuid())
  userId         String
  date           DateTime // truncated to the day this snapshot was taken
  followersCount Int
  mediaCount     Int
  createdAt      DateTime @default(now())

  @@unique([userId, date])
  @@index([userId])
}

/// A keyword→DM auto-reply rule. When someone comments `keyword` on `postId`
/// (or any post, if null), the webhook handler sends them a private reply
/// with `dmMessage` via the Instagram Send API — the "comment to DM" growth
/// tactic (ManyChat-style), built natively instead of standing up the
/// separate OpenReply-fa app (own Postgres/Redis) since OAuth + tokens for
/// this account are already handled by InstagramConnection above.
model InstagramCommentCampaign {
  id                 String   @id @default(cuid())
  userId             String
  /// Comma/Persian-comma separated — any one matching the comment text triggers the campaign.
  keyword            String
  postId             String?
  /// Supports the {username} token, replaced with the commenter's handle at send time.
  dmMessage          String
  publicReplyMessage String?
  /// JSON array of up to 2 {id,label,url,clicks} — sent as tracked short links appended to dmMessage.
  links              String?
  /// When on, the real dmMessage is withheld behind a "did you follow?" button
  /// in the DM — Meta gives no API to check an arbitrary commenter's follow
  /// status, so this is a self-reported confirm via a postback button instead.
  followGateEnabled  Boolean  @default(false)
  followGatePrompt   String?
  isActive           Boolean  @default(true)
  triggerCount       Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([userId])
}

/// One row per comment the webhook actually processed — the unique
/// `commentId` is what makes handling idempotent against Meta's webhook
/// retries (a comment can only ever trigger one DM, no matter how many
/// times the same event is redelivered).
model InstagramCommentReplyLog {
  id                String   @id @default(cuid())
  /// Null for status "no_match" — a comment that reached the webhook but
  /// matched no campaign. Recorded so the health watchdog can tell
  /// "no comments arrived" (fine) apart from "comments arrived and nothing
  /// was sent" (broken), which is exactly the distinction that let
  /// comment→DM sit dead for a month unnoticed.
  campaignId        String?
  /// Denormalized from the campaign's owner — lets the per-hour rate-limit
  /// count be a single indexed query instead of a join through the campaign.
  userId            String?
  commentId         String   @unique
  commenterId       String
  commenterUsername String?
  /// "sent" | "sent_public_fallback" (DM blocked pending instagram_manage_messages
  /// App Review — delivered as a public reply instead) | "skipped" | "failed" |
  /// "no_match" | "awaiting_follow" (follow-gated campaign, waiting on the postback button click)
  status            String
  error             String?
  createdAt         DateTime @default(now())

  @@index([campaignId])
  @@index([userId, createdAt])
}

/// A generated Instagram post queued to go out. mode="auto" actually calls
/// the Instagram Graph API at scheduledFor (gated to PRO/TEAM plans —
/// see src/lib/utils/planGates.ts); mode="manual" just sits here so the
/// user can copy the caption/hashtags and post it themselves.
model ScheduledPost {
  id           String   @id @default(cuid())
  userId       String
  /// Business this post belongs to (nullable: legacy rows, and workspaces with no provisioned business).
  businessId   String?
  caption      String
  hashtags     String
  imageUrl     String?
  /// Reel video — mutually exclusive with imageUrl in practice (the wizard only lets the user pick one), but not DB-enforced since either alone is valid.
  videoUrl     String?
  scheduledFor DateTime
  mode         String // "auto" | "manual"
  status       String   @default("PENDING") // PENDING | PUBLISHED | FAILED
  igMediaId    String?
  errorMessage String?
  /// Rule-based content-quality score (0-100) at generation time, plus the
  /// fixes suggested then — kept so a post's predicted score can later be
  /// compared against its real reach/engagement and the rules tuned against
  /// this account's own history rather than generic advice.
  qualityScore Int?
  /// JSON array of the quality findings shown to the owner before scheduling.
  qualityNotes String?
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([businessId])
  @@index([status, scheduledFor])
}

model SeoConnection {
  id            String   @id @default(cuid())
  userId        String   @unique
  platform      String // "wordpress" | "aifekr" | "other"
  siteUrl       String?
  wpUsername    String?
  wpAppPassword String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model GscConnection {
  id           String   @id @default(cuid())
  userId       String   @unique
  refreshToken String
  siteUrl      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// A website a user tracks in the SEO Command Center. Audits are saved per site
/// so progress can be compared over time and re-run automatically.
model SeoSite {
  id          String    @id @default(cuid())
  userId      String
  businessId  String?
  /// Normalised origin, e.g. "https://mysite.com/"
  url         String
  name        String?
  /// Re-audit automatically on a schedule (see /api/cron/seo-audits)
  autoAudit   Boolean   @default(true)
  /// "daily" | "weekly" | "monthly"
  frequency   String    @default("weekly")
  lastAuditAt DateTime?
  nextAuditAt DateTime?
  lastScore   Int?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  audits      SeoAudit[]
  contentPlan SeoContentPlan?
  rankSnapshots SeoRankSnapshot[]

  @@unique([userId, url])
  @@index([userId])
  @@index([businessId])
  @@index([autoAudit, nextAuditAt])
}

/// One saved audit of a site (several pages crawled). `pages` and `siteChecks`
/// hold compact JSON; only non-passing checks are stored per page.
model SeoAudit {
  id            String    @id @default(cuid())
  siteId        String
  userId        String
  /// "manual" | "auto"
  source        String    @default("manual")
  score         Int
  /// Average score of the crawled pages as a phone sees them (null when no mobile crawl succeeded)
  mobileScore   Int?
  pagesCrawled  Int
  failCount     Int
  warnCount     Int
  passCount     Int
  siteChecks    String
  pages         String
  /// AI improvement plan (JSON), generated on demand and saved with the audit
  plan          String?
  planCreatedAt DateTime?
  createdAt     DateTime  @default(now())

  site SeoSite @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId, createdAt])
  @@index([userId])
}

/// Blog automation for a tracked site: on a schedule the content pipeline writes
/// the next post and either saves it in AiFekr only, as a WordPress draft, or
/// publishes it live. Default is "draft" -- nothing goes live without opting in.
model SeoContentPlan {
  id           String    @id @default(cuid())
  siteId       String    @unique
  userId       String
  enabled      Boolean   @default(false)
  /// What the blog is about; used when the topic queue is empty
  theme        String    @default("")
  /// JSON array of topics to write about, consumed one per run
  topics       String    @default("[]")
  brandVoice   String?
  /// Language the posts are written in (captured from the UI language when the plan is saved)
  lang         String    @default("fa")
  /// "daily" | "every3days" | "weekly" | "biweekly"
  frequency    String    @default("weekly")
  /// "draft" (WordPress draft) | "publish" (live) | "hold" (kept in AiFekr only)
  mode         String    @default("draft")
  nextRunAt    DateTime?
  lastRunAt    DateTime?
  lastError    String?
  /// Set while a run is in flight so two cron ticks cannot start the same plan twice
  runningSince DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  site SeoSite @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([enabled, nextRunAt])
  @@index([userId])
}

/// One query's real Search Console numbers for a tracked site over a 7-day window
/// ending on `date`. Only ever written from Search Console data -- never estimated.
model SeoRankSnapshot {
  id          String   @id @default(cuid())
  siteId      String
  /// Last day (UTC, yyyy-mm-dd) of the 7-day window this row covers
  date        String
  query       String
  clicks      Int
  impressions Int
  ctr         Float
  position    Float
  createdAt   DateTime @default(now())

  site SeoSite @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([siteId, date, query])
  @@index([siteId, date])
}

model IndustryPack {
  id                 String               @id @default(cuid())
  slug               String               @unique
  name               String
  nameEn             String?
  /// German content, same nullable-fallback convention as the *En fields --
  /// added when German coverage was found missing platform-wide (this model
  /// had no German columns at all, so a German visitor silently fell back
  /// to English or Persian depending on the render site).
  nameDe             String?
  emoji              String
  tagline            String
  taglineEn          String?
  taglineDe          String?
  valueProposition   String
  valuePropositionEn String?
  valuePropositionDe String?
  targetCustomers    String
  targetCustomersEn  String?
  targetCustomersDe  String?
  painPoints         String
  painPointsEn       String?
  painPointsDe       String?
  agents             String
  agentsEn           String?
  agentsDe           String?
  outcomes           String
  outcomesEn         String?
  outcomesDe         String?
  kpis               String
  kpisEn             String?
  kpisDe             String?
  tier               String               @default("professional")
  price              Int                  @default(299)
  color              String
  gradientFrom       String
  gradientTo         String
  isActive           Boolean              @default(true)
  sortOrder          Int                  @default(0)
  users              User[]
  companies          Company[]
  moduleFlags        IndustryModuleFlag[]
}

model BusinessCategory {
  id        String    @id @default(cuid())
  name      String
  nameEn    String
  icon      String    @default("🏢")
  color     String    @default("#ea580c")
  isActive  Boolean   @default(true)
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())
  companies Company[]
}

model Company {
  id             String   @id @default(cuid())
  userId         String   @unique
  name           String
  industry       String
  website        String?
  phone          String?
  email          String?
  address        String?
  size           String?
  revenue        String?
  industryPackId String?
  categoryId     String?
  isActive       Boolean  @default(true)
  notes          String?
  /// Company logo, uploaded once in Business Doctor and reused on every
  /// invoice/contract (CRM) and payslip/owner-statement (accounting) print
  /// output, so a business never has to re-upload its branding per document.
  logoUrl        String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  industryPack IndustryPack?     @relation(fields: [industryPackId], references: [id])
  category     BusinessCategory? @relation(fields: [categoryId], references: [id])

  @@index([industryPackId])
  @@index([categoryId])
}

/// Logged every time the AI router falls back to a different provider.
/// Used by the admin panel to surface reliability issues.
model ProviderFallbackLog {
  id           String   @id @default(cuid())
  /// Provider that failed (e.g. "claude", "openai")
  fromProvider String
  /// Provider that took over; null if all failed
  toProvider   String?
  /// Error or timeout message (truncated to 500 chars)
  reason       String
  /// Detected prompt category (code, math, general, …)
  category     String   @default("general")
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([fromProvider])
}

/// One end-to-end run of the 8-agent content pipeline (ideaFinder → strategist →
/// researcher → writer → editor → seo → publisher → critic) for a single topic.
model ContentPipelineRun {
  id         String   @id @default(cuid())
  userId     String
  topic      String
  brandVoice String?
  /// "running" | "done" | "failed"
  status     String   @default("running")
  shareToken String?  @unique
  /// SeoContentPlan that started this run (null for runs started by hand)
  planId     String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user  User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  steps ContentPipelineStep[]
  post  ContentPost?

  @@index([userId])
  @@index([planId])
}

/// Output of a single agent within one pipeline run. A writer/editor
/// back-and-forth produces multiple rows with the same agentKey and
/// increasing `attempt`.
model ContentPipelineStep {
  id        String   @id @default(cuid())
  runId     String
  /// "ideaFinder" | "strategist" | "researcher" | "writer" | "editor" | "seo" | "publisher" | "critic"
  agentKey  String
  attempt   Int      @default(1)
  /// "running" | "done" | "failed"
  status    String   @default("running")
  input     String
  output    String?
  /// Editor's 0-100 quality score, only set for agentKey="editor"
  score     Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  run ContentPipelineRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
}

/// Persistent, accumulating feedback for one agent role — written by the
/// critic agent after a run, or manually by a user. Injected into that
/// agent's system prompt on every future run so the pipeline improves
/// over time.
model ContentAgentLesson {
  id        String   @id @default(cuid())
  userId    String
  agentKey  String
  text      String
  /// "critic" | "user"
  source    String   @default("critic")
  /// JSON-stringified embedding vector for semantic retrieval (RAG) — null
  /// if embedding generation failed or hasn't run yet; retrieval falls back
  /// to recency ordering for rows without one.
  embedding String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, agentKey])
}

/// Shared, cross-tool knowledge base for the CEO orchestrator — written by
/// the CEO agent after each analysis, or manually by the user. This is what
/// lets "the system remember" across CEO runs instead of starting from zero
/// each time, same pattern as ContentAgentLesson but business-wide rather
/// than scoped to one agent role.
model BusinessMemory {
  id        String   @id @default(cuid())
  userId    String
  /// "sales" | "content" | "seo" | "social" | "general"
  category  String   @default("general")
  text      String
  /// "ceo" | "user"
  source    String   @default("ceo")
  /// JSON-stringified embedding vector for semantic retrieval (RAG) — null
  /// if embedding generation failed or hasn't run yet; retrieval falls back
  /// to recency ordering for rows without one.
  embedding String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, category])
}

/// A published blog post produced by the pipeline.
model ContentPost {
  id              String   @id @default(cuid())
  userId          String
  runId           String   @unique
  title           String
  content         String
  metaTitle       String
  metaDescription String
  slug            String
  keywords        String
  heroImageUrl    String?
  publishedAt     DateTime @default(now())
  /// "not_published" | "published" | "failed" — result of publishing to the user's connected WordPress site
  externalStatus  String   @default("not_published")
  externalUrl     String?
  externalError   String?

  user User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  run  ContentPipelineRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model StartupProject {
