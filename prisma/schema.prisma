/// A task auto-created by the AI CEO or Boardroom for a specific department.
model CeoTask {
  id               String   @id @default(cuid())
  userId           String
  title            String
  description      String?
  department       String
  priority         String   @default("medium")
  status           String   @default("pending")
  requiresApproval Boolean  @default(false)
  estimatedImpact  String?
  source           String   @default("ceo")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, status])
}

/// A single AI Boardroom session — department analyses + CEO synthesis.
model BoardroomSession {
  id          String   @id @default(cuid())
  userId      String
  status      String   @default("running")
  healthScore Int?
  summary     String?
  departments String?
  tasksJson   String?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// ── Voice Agent add-on (AI real-estate calling agent) ──────────────────────
/// Gated by User.voicePlan, same pattern as crmPlan. One user can run multiple
/// named agents (e.g. "Buyer Line", "Rental Line"), each backed by a Vapi
/// assistant + phone number. See src/lib/voice/workspace.ts for the gate and
/// src/lib/voice/vapiClient.ts for the Vapi API wrapper.
model VoiceAgent {
  id                String   @id @default(cuid())
  userId            String
  name              String
  /// "buy" | "sell" | "rent" | "general" — shapes the default system prompt.
  focus             String   @default("general")
  /// "real_estate" | "general" — which Vapi tool set gets registered for this
  /// agent (see buildVoiceAgentTools() in src/lib/voice/vapiClient.ts).
  /// "real_estate" keeps the existing search_properties/book_appointment
  /// tools; "general" swaps in a business-agnostic tool set so the Voice
  /// Agent add-on works for any business, not just real estate. Extensible
  /// to future verticals without a schema change (plain string, not an enum).
  vertical          String   @default("real_estate")
  /// Free-text business type/description, only used when vertical="general"
  /// (e.g. "Dental clinic", "Law firm") — interpolated into the default
  /// system prompt so the assistant knows what business it represents.
  businessType      String?
  systemPrompt      String
  /// Vapi voice id (e.g. "jennifer") — cosmetic, defaults server-side if unset.
  voiceId           String?
  /// E.164 phone number assigned to this agent once provisioned via Vapi.
  phoneNumber       String?
  vapiAssistantId   String?
  vapiPhoneNumberId String?
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  properties    Property[]
  calls         VoiceCallLog[]
  appointments  VoiceAppointment[]
  knowledgeBase VoiceKnowledgeBase[]

  @@index([userId])
}

/// A Q&A / policy / info snippet the agent can pull from mid-call when a
/// caller asks something outside the property-search/booking flow (opening
/// hours, financing terms, company policy, etc.) — a lightweight knowledge
/// base, not a vector index. `agentId` null means it applies to every one of
/// the user's agents; set means it's specific to that one agent.
model VoiceKnowledgeBase {
  id        String   @id @default(cuid())
  userId    String
  agentId   String?
  title     String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  agent VoiceAgent? @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([agentId])
}

/// A listing the agent can reference/offer during a call. Kept separate from
/// any future generic "Property" model — intentionally scoped to this add-on.
/// Industry-agnostic "extension record" attached to a CRM contact/deal —
/// currently only populated by the real-estate voice agent (hence the
/// mapped table name, kept as-is to avoid a physical rename), but the shape
/// (owner + optional CrmContact/CrmDeal links + industry-specific columns)
/// is the reusable pattern for any future industry needing structured
/// records beyond CrmContact/CrmDeal's generic customFields JSON blob
/// (e.g. a future VehicleRecord for a car dealership would follow the same
/// shape: its own table, optional FKs into CRM, zero changes to CRM core).
model Property {
  id                      String    @id @default(cuid())
  userId                  String
  agentId                 String?
  /// Optional link to the CRM lead interested in / associated with this
  /// property (a contact may be linked to several properties they're
  /// browsing). Nullable — a property can exist with no CRM contact yet.
  crmContactId            String?
  /// Optional link to the specific deal this property is being sold/rented
  /// through — set once a contact's interest turns into an active deal.
  crmDealId               String?
  /// Optional link to a CRM Project (the general post-sale/ongoing-work
  /// tracker) — set for the real-estate industry pack's "پروژه‌های ملکی"
  /// feature, so a project's transaction-type-specific fields (short-term
  /// rental booking link/nightly price, below) live on this single unified
  /// Property row rather than a separate real-estate-only table.
  crmProjectId            String?
  /// Accounting module Phase B — the CrmContact (role: owner) this unit's
  /// short-term-rental income/expenses/management fee are settled with via
  /// AccountingOwnerStatement. Only meaningful for listingType
  /// "short_term_rent"; null otherwise.
  ownerContactId          String?
  title                   String
  /// "buy" | "sell" | "rent" | "short_term_rent"
  listingType             String
  propertyType            String    @default("apartment")
  /// Price in Toman. For listingType "short_term_rent" this is unused —
  /// nightlyPrice is the relevant figure instead.
  /// BigInt, not Int — Toman real-estate prices routinely exceed 2.1B (Int32 max).
  price                   BigInt
  /// Per-night price in Toman — only meaningful when listingType is
  /// "short_term_rent". BigInt for the same overflow reason as price.
  nightlyPrice            BigInt?
  /// Booking-platform listing URL for short-term rentals — deliberately
  /// generic ("booking platform link"), not Airbnb-specific, so Booking.com
  /// or a future in-house booking page can be added later without a schema
  /// change. Not validated as a strict URL at the DB layer — malformed
  /// values are a warning in the UI, not a save-blocking error, since an
  /// agent may want to create the project before the listing link exists.
  bookingLink             String?
  address                 String
  city                    String?
  bedrooms                Int?
  bathrooms               Int?
  areaSqm                 Int?
  description             String?
  /// JSON array of image URLs (uploaded via the same R2 storage used by
  /// CrmDocument). Nullable — a property can exist with no photos yet.
  images                  String?
  /// IRT (Toman) | IRR (Rial) | USD | GBP | EUR — price/nightlyPrice are
  /// stored in this currency's smallest common display unit (Toman/Rial
  /// for IRT/IRR, cents-free whole units for USD/GBP/EUR — this platform
  /// doesn't handle sub-unit precision anywhere else either). Defaults to
  /// IRT since every existing row was priced in Toman before this field
  /// existed.
  currency                String    @default("IRT")
  status                  String    @default("available") // available | pending | sold | rented
  /// Owner-representation terms (Section 1, item 2) — deliberately kept on
  /// Property rather than on CrmContact, since a single owner contact can
  /// have different representation dates/commission per listing. "Owner"
  /// itself is not a stored role — a contact IS an owner by being linked
  /// here via crmContactId to >=1 property; see /api/crm/owners.
  representationStartDate DateTime?
  representationEndDate   DateTime?
  /// Commission percentage agreed with the owner at listing time (e.g. 2.5
  /// meaning 2.5%) — distinct from CrmDeal's eventual closing commission
  /// (item 5), which is the actual amount once a deal closes.
  agreedCommissionRate    Float?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  user              User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  agent             VoiceAgent?                @relation(fields: [agentId], references: [id], onDelete: SetNull)
  crmContact        CrmContact?                @relation(fields: [crmContactId], references: [id], onDelete: SetNull)
  crmDeal           CrmDeal?                   @relation(fields: [crmDealId], references: [id], onDelete: SetNull)
  crmProject        CrmProject?                @relation(fields: [crmProjectId], references: [id], onDelete: SetNull)
  appointments      VoiceAppointment[]
  viewings          PropertyViewing[]
  bookings          PropertyBooking[]
  documents         CrmDocument[]
  interests         PropertyInterest[]
  ownerStatements   AccountingOwnerStatement[]
  AccountingExpense AccountingExpense[]

  @@index([userId])
  @@index([agentId])
  @@index([crmContactId])
  @@index([crmDealId])
  @@index([crmProjectId])
  @@map("VoiceProperty")
}

/// Section 1, item 4 — Viewing Scheduler. A real calendar slot (not a text
/// field), so double-booking can be checked server-side, distinct from
/// VoiceAppointment (which is structurally tied to a VoiceAgent's phone
/// calls and has a required agentId). assignedToId is a human CRM team
/// member's userId — nullable until someone is assigned.
model PropertyViewing {
  id             String   @id @default(cuid())
  /// Workspace owner's id (ws.workspaceUserId), same scoping convention as
  /// every other CRM model — never the raw session user id.
  userId         String
  propertyId     String
  /// The buyer/lead attending the viewing — optional so a slot can be
  /// blocked out before a specific contact is confirmed.
  contactId      String?
  /// Human team member conducting the viewing — optional until assigned;
  /// double-booking is only checked once this is set (see api/crm/viewings).
  assignedToId   String?
  scheduledAt    DateTime
  durationMin    Int      @default(30)
  /// scheduled | completed | cancelled | no_show
  status         String   @default("scheduled")
  /// Post-viewing feedback captured from the buyer or the agent — required
  /// by the master spec ("post-viewing feedback capture"), free text since
  /// the shape of useful feedback varies too much for a fixed schema.
  feedback       String?
  feedbackRating Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  property   Property    @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  contact    CrmContact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  assignedTo User?       @relation("PropertyViewingAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([propertyId])
  @@index([contactId])
  @@index([assignedToId])
  @@index([scheduledAt])
}

/// Section 1, item 6 — Short-term rental occupancy calendar. Mandatory (not
/// optional) UI for any Property with listingType "short_term_rent", to
/// prevent double-booking the same nights. Coordinates with (does not
/// replace) Property.bookingLink: as of this research, Airbnb/Booking.com
/// only offer one-way, non-instant iCal export/import (no live two-way
/// API for unaffiliated apps), so this table is the source of truth for
/// in-app scheduling — bookingLink stays a manual reference for the agent
/// to cross-check, not an automated sync target.
model PropertyBooking {
  id         String   @id @default(cuid())
  /// Workspace owner's id, same scoping convention as every other CRM model.
  userId     String
  propertyId String
  checkIn    DateTime
  checkOut   DateTime
  guestName  String?
  /// Optional link to the CRM lead who booked, if known.
  contactId  String?
  /// manual | airbnb_ical | booking_ical — free-text today since only
  /// "manual" is actually wired up; kept open for when iCal import lands.
  source     String   @default("manual")
  /// confirmed | cancelled
  status     String   @default("confirmed")
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  property Property    @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  contact  CrmContact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([propertyId])
  @@index([contactId])
  @@index([checkIn])
  @@index([checkOut])
}

/// One row per phone call handled by a VoiceAgent, populated from Vapi's
/// end-of-call-report webhook (see src/app/api/webhooks/vapi/route.ts).
model VoiceCallLog {
  id           String    @id @default(cuid())
  userId       String
  agentId      String
  /// Best-effort match to a CRM contact by phone number (see matchCrmContactByPhone()
  /// in src/lib/voice/crmLink.ts) — null when no match was found. Never
  /// auto-creates a new CrmContact; that stays a manual/user decision.
  contactId    String?
  vapiCallId   String?   @unique
  callerPhone  String?
  direction    String    @default("inbound") // inbound | outbound
  status       String    @default("in_progress") // in_progress | completed | failed | no_answer
  /// qualified | not_interested | appointment_booked | callback_requested | unknown
  outcome      String?
  transcript   String?
  summary      String?
  durationSec  Int?
  recordingUrl String?
  /// Call cost in USD, as reported by Vapi.
  cost         Float?
  createdAt    DateTime  @default(now())
  endedAt      DateTime?

  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  agent       VoiceAgent        @relation(fields: [agentId], references: [id], onDelete: Cascade)
  contact     CrmContact?       @relation(fields: [contactId], references: [id], onDelete: SetNull)
  appointment VoiceAppointment?

  @@index([userId])
  @@index([agentId])
  @@index([contactId])
}

/// A property viewing booked by the agent during (or after) a call.
model VoiceAppointment {
  id          String   @id @default(cuid())
  userId      String
  agentId     String
  propertyId  String?
  callLogId   String?  @unique
  leadName    String?
  leadPhone   String?
  scheduledAt DateTime
  status      String   @default("pending") // pending | confirmed | completed | cancelled | no_show
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  agent    VoiceAgent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  property Property?     @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  callLog  VoiceCallLog? @relation(fields: [callLogId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([agentId])
}

/// A rendered invite-card generation record (admin "Invite to AIfekr" tool).
/// Never stores a referral code of its own — always reads User.referralCode
/// at render time (the same single source of truth the user's own
/// dashboard reads), and never stores the raw temporary password — only
/// the language/text shown, for audit purposes.
model InviteCard {
  id          String   @id @default(cuid())
  userId      String
  language    String // "fa" | "en" | "de"
  inviteText  String
  /// The rendered PNG, uploaded to R2 storage — lets an admin revisit a
  /// past card without regenerating it. Never a password/credential.
  imageUrl    String?
  generatedBy String // admin User.id
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Generic admin-action audit trail — who did what, to whom, when. Started
/// for the "Invite to AIfekr" tool (trial activation, invite-card
/// generation) but deliberately generic so other admin tools can log to it
/// too rather than each inventing their own audit table.
model AuditLog {
  id        String   @id @default(cuid())
  actorId   String // admin User.id who performed the action
  action    String // e.g. "trial_activated" | "invite_card_generated"
  targetId  String? // e.g. the affected User.id
  metadata  String? // JSON-encoded extra detail
  createdAt DateTime @default(now())

  @@index([actorId])
  @@index([targetId])
  @@index([action])
}

/// ─── Accounting module (Phase A: ledger core) ───────────────────────────
/// Per accounting_master_prompt.md/accounting_module_spec.md, Phase A. Tenant
/// isolation is application-level (workspaceUserId, matching
/// resolveCrmWorkspace()'s pattern everywhere else in this codebase) rather
/// than Postgres RLS — this codebase runs on SQLite, which has no RLS, and
/// the user explicitly confirmed reusing the existing app-level pattern
/// instead of the spec's Postgres-specific assumption. See src/lib/accounting/ledger.ts
/// for the single enforced write path (postJournalEntry()) — nothing else
/// may insert into AccountingJournalEntryLine directly.
model AccountingAccount {
  id              String   @id @default(cuid())
  workspaceUserId String
  code            String
  name            String
  nameEn          String?
  nameDe          String?
  /// "asset" | "liability" | "equity" | "revenue" | "expense"
  type            String
  parentId        String?
  /// Seeded default-chart-of-accounts row — shown but not user-deletable.
  isSystem        Boolean  @default(false)
  createdAt       DateTime @default(now())

  parent   AccountingAccount?           @relation("AccountHierarchy", fields: [parentId], references: [id])
  children AccountingAccount[]          @relation("AccountHierarchy")
  lines    AccountingJournalEntryLine[]

  @@unique([workspaceUserId, code])
  @@index([workspaceUserId])
}

/// One row per financial period an admin can lock. Locking blocks new
/// postings dated inside the range — enforced inside postJournalEntry(),
/// the only write path, since SQLite has no deferred/cross-table constraint
/// triggers capable of expressing "reject if any locked period covers this
/// date" declaratively.
model AccountingFiscalPeriod {
  id              String    @id @default(cuid())
  workspaceUserId String
  startDate       DateTime
  endDate         DateTime
  isLocked        Boolean   @default(false)
  lockedAt        DateTime?
  lockedBy        String?
  createdAt       DateTime  @default(now())

  @@index([workspaceUserId])
}

/// A balanced double-entry posting. Immutable once created — see comment on
/// reversesEntryId. Never updated/deleted; a correction always creates a new
/// reversal entry (isReversed flips true on the original) plus a new
/// corrected entry, both linked back for a full audit trail.
model AccountingJournalEntry {
  id              String   @id @default(cuid())
  workspaceUserId String
  entryDate       DateTime @default(now())
  memo            String?
  /// Idempotency + traceability key for auto-posted entries, e.g.
  /// "invoice:sent:<invoiceId>" / "invoice:paid:<invoiceId>". A unique
  /// constraint here is what makes automatic posting from a CRM event
  /// idempotent — a retried event / duplicate webhook simply finds the
  /// existing entry and no-ops instead of double-posting. Null for entries
  /// entered manually by an accountant.
  sourceRef       String?  @unique
  reversesEntryId String?
  isReversed      Boolean  @default(false)
  /// User.id who posted it, or the literal string "system" for auto-posted
  /// entries (invoice events, etc.) with no human actor.
  postedBy        String
  createdAt       DateTime @default(now())

  lines         AccountingJournalEntryLine[]
  reversesEntry AccountingJournalEntry?      @relation("Reversal", fields: [reversesEntryId], references: [id])
  reversedBy    AccountingJournalEntry[]     @relation("Reversal")

  @@index([workspaceUserId, entryDate])
}

/// One debit or credit leg of a journal entry. `debit`/`credit` are
/// mutually exclusive per row (exactly one is > 0, the other is 0) —
/// enforced by a CHECK constraint at the database level (see migration SQL)
/// as well as in postJournalEntry(). The cross-row invariant "sum(debit) ==
/// sum(credit) for a given entry" is a multi-row invariant SQLite's
/// synchronous, non-deferrable triggers cannot express safely alongside a
/// multi-row insert; that half of the balance guarantee is enforced solely
/// by postJournalEntry() being the one and only write path — see its unit
/// tests for the enforcement proof.
model AccountingJournalEntryLine {
  id        String  @id @default(cuid())
  entryId   String
  accountId String
  debit     Float   @default(0)
  credit    Float   @default(0)
  memo      String?

  entry   AccountingJournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  account AccountingAccount      @relation(fields: [accountId], references: [id])

  @@index([entryId])
  @@index([accountId])
}

/// ─── Accounting module Phase B ──────────────────────────────────────────
/// Expenses/vendors/approval, agent commission + split, and short-term
/// rental owner statements. Every economic event here posts through
/// postJournalEntry() (see src/lib/accounting/ledger.ts) — nothing here
/// writes AccountingJournalEntryLine directly.

model AccountingVendor {
  id              String   @id @default(cuid())
  workspaceUserId String
  name            String
  phone           String?
  email           String?
  notes           String?
  createdAt       DateTime @default(now())

  expenses AccountingExpense[]

  @@index([workspaceUserId])
}

/// Covers both spec ۳.۳ concepts — a supplier bill and a standalone cash
/// expense — as one model distinguished by `kind`, rather than two near-
/// identical tables. `status` carries the approval workflow: an expense
/// over the workspace's approval threshold sits at "pending_approval" until
/// a manager approves it; only "approved" or "paid" expenses may post to
/// the ledger.
model AccountingExpense {
  id              String    @id @default(cuid())
  workspaceUserId String
  vendorId        String?
  /// "bill" | "cash_expense"
  kind            String    @default("cash_expense")
  /// AccountingAccount.code this expense books against, e.g. "5200" (Advertising).
  accountCode     String
  amount          Float
  /// VAT/input tax paid on this expense, included in `amount` (not on top
  /// of it) — used only for the Phase C VAT report's input-tax side.
  taxAmount       Float     @default(0)
  description     String
  receiptUrl      String?
  expenseDate     DateTime  @default(now())
  dueDate         DateTime?
  /// Which property this cost belongs to — the electricity bill or the cleaning
  /// supplies for one specific unit. Nullable on purpose: office rent or a
  /// software subscription belongs to the agency, not to any single property.
  /// Without it there was no way to answer "what has this unit cost me?", and
  /// owner statements had their expense lines retyped by hand every month.
  propertyId      String?
  /// "pending_approval" | "approved" | "rejected" | "paid"
  status          String    @default("approved")
  approvedBy      String?
  approvedAt      DateTime?
  paidAt          DateTime?
  createdAt       DateTime  @default(now())

  vendor   AccountingVendor? @relation(fields: [vendorId], references: [id])
  property Property?         @relation(fields: [propertyId], references: [id])

  @@index([workspaceUserId])
  @@index([vendorId])
}

/// One row per won deal that earns commission. Split across multiple agents
/// via AccountingCommissionSplit — see spec ۳.۴'s "Split Commission".
model AccountingCommissionRecord {
  id              String   @id @default(cuid())
  workspaceUserId String
  dealId          String
  totalAmount     Float
  createdAt       DateTime @default(now())

  deal   CrmDeal                     @relation(fields: [dealId], references: [id])
  splits AccountingCommissionSplit[]

  @@index([workspaceUserId])
  @@index([dealId])
}

model AccountingCommissionSplit {
  id                 String    @id @default(cuid())
  commissionRecordId String
  /// User.id of the agent this split is owed to.
  agentUserId        String
  percent            Float
  amount             Float
  /// "pending" | "paid"
  status             String    @default("pending")
  paidAt             DateTime?
  createdAt          DateTime  @default(now())

  commissionRecord AccountingCommissionRecord @relation(fields: [commissionRecordId], references: [id], onDelete: Cascade)

  @@index([commissionRecordId])
  @@index([agentUserId])
}

/// Per-property (or per-owner, when propertyId is null — the workspace
/// default) management fee percentage taken from short-term rental net
/// profit. A property-level row overrides the owner/workspace default.
model AccountingManagementFeeRule {
  id              String   @id @default(cuid())
  workspaceUserId String
  propertyId      String?  @unique
  feePercent      Float    @default(20)
  createdAt       DateTime @default(now())

  @@index([workspaceUserId])
}

/// One statement per property per month — the Draft-and-Approve envelope
/// around a batch of AccountingOwnerStatementEntry rows. Numbers are
/// computed and frozen at generation time (not re-derived live), so an
/// approved/sent statement never silently changes if entries are edited
/// later — a correction means regenerating a new draft.
model AccountingOwnerStatement {
  id              String    @id @default(cuid())
  workspaceUserId String
  propertyId      String
  /// First day of the statement's month, e.g. 2026-08-01T00:00:00Z.
  month           DateTime
  currency        String    @default("IRT")
  incomeTotal     Float     @default(0)
  expenseTotal    Float     @default(0)
  netProfit       Float     @default(0)
  managementFee   Float     @default(0)
  ownerShare      Float     @default(0)
  /// "draft" | "approved" | "sent"
  status          String    @default("draft")
  approvedBy      String?
  approvedAt      DateTime?
  sentAt          DateTime?
  createdAt       DateTime  @default(now())

  property Property                        @relation(fields: [propertyId], references: [id])
  entries  AccountingOwnerStatementEntry[]

  @@unique([propertyId, month])
  @@index([workspaceUserId])
}

model AccountingOwnerStatementEntry {
  id          String   @id @default(cuid())
  statementId String
  date        DateTime
  description String
  /// "guest_stay" | "maintenance" | "utilities" | "consumables" | "other"
  category    String
  income      Float    @default(0)
  expense     Float    @default(0)
  createdAt   DateTime @default(now())

  statement AccountingOwnerStatement @relation(fields: [statementId], references: [id], onDelete: Cascade)

  @@index([statementId])
}

/// ─── Accounting module Phase C ──────────────────────────────────────────
/// Bank reconciliation, VAT reporting, and budgeting. Everything here is
/// read/reconciliation tooling around the Phase A/B ledger — none of it
/// posts new journal entries on its own (a matched bank transaction
/// confirms money already recorded via an expense/invoice payment; it
/// doesn't create new financial facts).

model AccountingBankAccount {
  id              String   @id @default(cuid())
  workspaceUserId String
  name            String
  accountNumber   String?
  currency        String   @default("IRT")
  /// Balance before the earliest imported transaction — the anchor a
  /// running balance is computed from, since Iran has no widespread Open
  /// Banking API to pull a canonical starting balance from (spec ۳.۶).
  openingBalance  Float    @default(0)
  createdAt       DateTime @default(now())

  transactions AccountingBankTransaction[]

  @@index([workspaceUserId])
}

/// One row per imported bank statement line (CSV/Excel import, per spec —
/// no xlsx dependency; reuses the dependency-free CSV parser already built
/// for property import). Reconciliation links a transaction to the
/// existing record that already explains it — it never creates a ledger
/// entry itself.
model AccountingBankTransaction {
  id              String    @id @default(cuid())
  workspaceUserId String
  bankAccountId   String
  date            DateTime
  description     String
  /// Positive = money in, negative = money out.
  amount          Float
  /// "unmatched" | "matched" | "ignored"
  status          String    @default("unmatched")
  /// "expense" | "invoice" — which table matchedId points into. Null until matched.
  matchedType     String?
  matchedId       String?
  matchedAt       DateTime?
  matchedBy       String?
  createdAt       DateTime  @default(now())

  bankAccount AccountingBankAccount @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)

  @@index([workspaceUserId])
  @@index([bankAccountId])
  @@index([status])
}

/// Configurable tax rates (spec ۳.۷) — Iran VAT, or a rate for an
/// international customer under Paddle. Invoices already carry their own
/// per-line taxRate (CrmInvoiceItem.taxRate); this is the named-rate
/// picklist an admin manages, not a new tax engine.
model AccountingTaxRate {
  id              String   @id @default(cuid())
  workspaceUserId String
  name            String
  ratePercent     Float
  isDefault       Boolean  @default(false)
  createdAt       DateTime @default(now())

  @@index([workspaceUserId])
}

/// One row per account/period budget line (spec ۳.۸). Compared against
/// actual ledger activity for Budget vs Actual — never a source of truth
/// for real numbers itself.
model AccountingBudget {
  id              String   @id @default(cuid())
  workspaceUserId String
  accountCode     String
  /// First day of the budgeted month.
  period          DateTime
  amount          Float
  createdAt       DateTime @default(now())

  @@unique([workspaceUserId, accountCode, period])
  @@index([workspaceUserId])
}

// ---------------------------------------------------------------------------
// Phase D — payroll, scheduled reports, external BI export (spec ۳.۵ / ۴).
// ---------------------------------------------------------------------------

/// One row per paid employee/agent in a workspace (spec ۳.۵ — simple payroll:
/// base salary + commission + bonus/deductions). userId links to an app User
/// (usually a TeamMember) so commission earned via AccountingCommissionSplit
/// can be pulled in automatically; it is nullable because a workspace may pay
/// someone (e.g. an assistant) who has no login of their own.
model AccountingEmployee {
  id              String   @id @default(cuid())
  workspaceUserId String
  userId          String?
  name            String
  baseSalary      Float    @default(0)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  payslips AccountingPayslip[]

  @@index([workspaceUserId])
  @@index([userId])
}

/// One payroll run per workspace/month. Lifecycle mirrors the rest of the
/// module's Draft-and-Approve pattern: draft (payslips editable) → approved
/// (numbers frozen) → paid (posts the aggregate ledger entry). Never posts to
/// the ledger before "paid", and never re-editable once paid.
model AccountingPayrollRun {
  id              String    @id @default(cuid())
  workspaceUserId String
  /// First day of the paid month.
  period          DateTime
  /// "draft" | "approved" | "paid"
  status          String    @default("draft")
  createdAt       DateTime  @default(now())
  approvedBy      String?
  approvedAt      DateTime?
  paidBy          String?
  paidAt          DateTime?

  payslips AccountingPayslip[]

  @@unique([workspaceUserId, period])
  @@index([workspaceUserId])
}

/// One line per employee within a payroll run. commissionTotal is pulled from
/// AccountingCommissionSplit rows paid to this employee's userId during the
/// run's period — never a second, independently-typed number.
model AccountingPayslip {
  id              String   @id @default(cuid())
  payrollRunId    String
  employeeId      String
  baseSalary      Float
  commissionTotal Float    @default(0)
  bonus           Float    @default(0)
  deductions      Float    @default(0)
  netPay          Float
  createdAt       DateTime @default(now())

  payrollRun AccountingPayrollRun @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  employee   AccountingEmployee   @relation(fields: [employeeId], references: [id])

  @@unique([payrollRunId, employeeId])
  @@index([payrollRunId])
  @@index([employeeId])
}

/// Recurring emailed report config (spec ۴ "گزارش‌های زمان‌بندی‌شده"). Per the
/// master prompt's explicit rule for this phase, a newly-created report never
/// auto-emails: its first due run only generates a preview (firstRunPreview)
/// and waits in "awaiting_approval" for a human to review the actual content
/// before the recurring send is switched on permanently.
model AccountingScheduledReport {
  id              String    @id @default(cuid())
  workspaceUserId String
  /// "weekly_summary" | "monthly_pl" | "monthly_vat"
  reportType      String
  /// "weekly" | "monthly"
  frequency       String
  recipientEmail  String
  lang            String    @default("fa")
  /// Presentation currency for this report, independent of `lang` and of the
  /// reader's UI language: a Persian admin can schedule an English report in
  /// EUR. NULL means no conversion — amounts appear in the currency they were
  /// recorded in, which is always what the report leads with anyway.
  currency        String?
  /// "pending_first_approval" | "awaiting_approval" | "active" | "paused"
  status          String    @default("pending_first_approval")
  /// Snapshot (subject+html) of the run currently awaiting human approval.
  firstRunPreview String?
  lastRunAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([workspaceUserId])
}

/// A long-lived, revocable token for the external-BI read-only export API
/// (spec ۴ "API برای اتصال BI خارجی"). Only the sha256 hash is stored — the
/// raw token is shown to the user once, at creation, like any API-key pattern.
model AccountingApiToken {
  id              String    @id @default(cuid())
  workspaceUserId String
  label           String
  tokenHash       String    @unique
  createdAt       DateTime  @default(now())
  lastUsedAt      DateTime?
  revokedAt       DateTime?

  @@index([workspaceUserId])
}

// ---------------------------------------------------------------------------
// Phase E — Finance AI Agent (spec ۸). Per the master prompt's explicit rule
// for this phase: the agent has READ-ONLY access to financial data (via the
// existing report functions — reports.ts/tax.ts/budget.ts — never raw SQL or
// direct table writes); its only write path is this table, which always
// starts "pending" and is never itself a ledger/expense mutation. A human
// must call approveProposal() — which is the only code that actually posts
// to the ledger or updates an expense — before anything the AI suggested
// takes effect. Never bypass this table to let the agent write directly.
model AccountingAiProposal {
  id              String    @id @default(cuid())
  workspaceUserId String
  /// "journal_entry" | "expense_categorization"
  type            String
  /// JSON payload — shape depends on `type` (see financeAgent.ts).
  payload         String
  /// "pending" | "approved" | "rejected"
  status          String    @default("pending")
  /// The question/context that led to this proposal, for audit traceability.
  sourceContext   String?
  /// Provider id (e.g. "claude") that generated this proposal — required for
  /// the audit_log's "source: ai_agent + model version" traceability rule.
  modelUsed       String
  createdAt       DateTime  @default(now())
  reviewedBy      String?
  reviewedAt      DateTime?

  @@index([workspaceUserId])
  @@index([status])
}
