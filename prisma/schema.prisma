/// This is the single source of truth for general-plan pricing — the
/// /plans page and /api/payment/create both read from here (matched via
/// planCode) instead of a hardcoded array, so an admin edit here actually
/// changes what users see and pay. planCode must match one of the values
/// stored on User.plan (currently BASIC | PRO | TEAM — FREE has no row
/// here since it isn't purchasable).
model Package {
  id           String   @id @default(cuid())
  planCode     String   @unique
  name         String
  nameEn       String
  /// Price in Rial (IRR). toman = price/10. Used for ZarinPal (Iran).
  price        Int
  /// Price in USD cents (e.g. 1900 = $19.00). Null means Iran-only plan.
  priceUsd     Int?
  /// Market segment: "IR" (Iran only) | "INTL" (international only) | "BOTH"
  market       String   @default("IR")
  duration     Int      @default(30)
  credits      Int
  features     String
  featuresEn   String?
  isActive     Boolean  @default(true)
  isFeatured   Boolean  @default(false)
  color        String   @default("#ea580c")
  sortOrder    Int      @default(0)
  /// Seat count included for CRM_TEAM-type packages (null for non-CRM or
  /// solo packages). Enforced against Team.maxSeats when this package is purchased.
  crmSeatLimit Int?
  /// Seat count included for an AI workspace package. Kept separate from the
  /// CRM add-on limit: a business may buy either product independently.
  teamSeatLimit Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model LlmModel {
