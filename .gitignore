/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Database files
*.db
*.db-journal
*.db-shm
*.db-wal
prisma/prisma/

# Claude Code session files
.claude/

# OS
Thumbs.db

# graphify knowledge-graph output (regenerable)
/graphify-out/

# debug/build log dumps
build-out.txt
tsc-out.txt
tsc-errors.txt

# office lock files
~$*.docx

# local docs / backups / investor materials (not for the repo).
# Written as /docs/* rather than /docs/ so the one subtree below can be
# re-included — git will not descend into a directory excluded as a whole, so
# a negation under a plain `/docs/` rule would never match. Everything else in
# docs/ stays ignored, including env.local.backup.txt and prod.db.backup.
/docs/*

# ...except the support assistant's knowledge base, which is product content:
# it ships in the deploy, is read at runtime by the KB sync, and needs to be
# reviewable in a diff like any other change.
!/docs/knowledge-base/

# vendored OpenMontage tool (nested git repo, venv, node_modules, .env — not part of AIfekr app)
/tools/openmontage/

# CodeCortex local index (generated, machine-specific — regenerate with `cortex init .`)
/.codecortex/

# Local Codex/Cortex workspace metadata and generated skill notes
/.freebuff/
/.mcp.json
/Claude outputs/

# Isolated SEO preview/build output; configuration lives in the existing DB.
/.next-seo-dev/
/.next-seo-build/
/.next-seo-release/
!/docs/seo-intelligence-audit.md

/.next-commerce-release/
!/docs/admin-commerce-seo-voice.md

# Reviewed bilingual Telnyx support documentation.
!/docs/telnyx/
